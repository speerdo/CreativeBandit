---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ExitPopup from '../components/ExitPopup';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title,
  description = "Creative Bandit is a two-person studio pairing full-stack development and AI automation with design and motion. 8+ years experience with React, Vue.js, TypeScript, and modern AI APIs. Based in Indianapolis.",
  keywords = "AI automation consultant, full-stack developer, design and motion studio, React Vue.js TypeScript, workflow automation, HIPAA compliant web development, OpenAI integration, Indianapolis developer, web development, WordPress development, WordPress maintenance, headless WordPress",
  ogImage = "/og-image.png"
} = Astro.props;

// og:image must be absolute — relative paths are rejected by most social
// platforms. Astro.site comes from astro.config.mjs.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title} | Creative Bandit</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Creative Bandit" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Creative Bandit`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Creative Bandit" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | Creative Bandit`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="msapplication-TileColor" content="#0B0B0C" />
    
    <!-- Fonts: Archivo (variable width + weight) for display, Inter for body,
         Space Mono for technical labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="/textures/grain.png">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Inter:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Creative Bandit",
      "description": "Two-person studio pairing full-stack development and AI automation with design and motion.",
      "url": "https://creativebandit.studio",
      "logo": "https://creativebandit.studio/mascot/bandit-cat.svg",
      "foundingDate": "2026",
      "founder": [
        {
          "@type": "Person",
          "name": "Adam Speer"
        },
        {
          "@type": "Person",
          "name": "Katlyn"
        }
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Indianapolis",
        "addressRegion": "IN",
        "addressCountry": "US"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Customer Service",
        "email": "hello@creativebandit.studio",
        "telephone": "+1-317-660-5295",
        "url": "https://creativebandit.studio/contact"
      },
      "sameAs": [
        "https://github.com/speerdo"
      ],
      "services": [
        "AI Automation",
        "Web Development",
        "Full-Stack Development",
        "WordPress Development",
        "WordPress Maintenance",
        "Healthcare Technology",
        "E-commerce Development",
        "Workflow Automation"
      ]
    }
    </script>
  </head>
  <body class="bg-base text-paper flex flex-col min-h-screen">
    <div class="flame-gradient"></div>
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <ExitPopup client:only="react" />

    <script>
      // Navigation mobile menu toggle
      document.addEventListener('DOMContentLoaded', () => {
        const navToggle = document.getElementById('navToggle');
        const navMenu = document.getElementById('navMenu');
        
        if (navToggle && navMenu) {
          navToggle.addEventListener('click', () => {
            navMenu.classList.toggle('hidden');
            navMenu.classList.toggle('flex');
          });
        }
      });
    </script>
  </body>
</html>
