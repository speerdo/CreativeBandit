---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { organization, type SchemaNode } from '../lib/schema';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  /**
   * Page-specific JSON-LD, merged into the @graph after the Organization
   * node. Pass the entity that describes *this* page — Service, Article,
   * Person — because Organization alone is boilerplate. See lib/schema.ts.
   */
  schema?: SchemaNode[];
  /** Overrides og:type, which is "website" for everything but articles. */
  ogType?: string;
}

const {
  title,
  // Kept under 170 characters. Longer descriptions truncate in search results
  // and in assistant citations, which is the same rule our scanner applies.
  description = "A two-person Indianapolis studio pairing full-stack development and AI automation with design and motion. The white-label build team behind WordPress agencies.",
  keywords = "AI automation consultant, full-stack developer, design and motion studio, React Vue.js TypeScript, workflow automation, HIPAA compliant web development, OpenAI integration, Indianapolis developer, web development, WordPress development, WordPress maintenance, headless WordPress",
  ogImage = "/og-image.png",
  schema = [],
  ogType = "website"
} = Astro.props;

// og:image must be absolute — relative paths are rejected by most social
// platforms. Astro.site comes from astro.config.mjs.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

/*
 * One ld+json block per page rather than several. A single @graph keeps @id
 * references (provider, publisher, worksFor) resolvable within the document
 * instead of dangling across separate scripts.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, ...schema],
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title} | Creative Bandit</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Creative Bandit" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" type="application/rss+xml" title="Creative Bandit" href="/rss.xml" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} | Creative Bandit`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Creative Bandit" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} | Creative Bandit`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <!-- Additional SEO -->
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="msapplication-TileColor" content="#0B0B0C" />
    
    <!-- Fonts: Archivo (variable width + weight) for display, Inter for body,
         Space Mono for technical labels. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="/textures/grain.png">
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Inter:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data. Built in lib/schema.ts; page-specific entity
         nodes arrive via the `schema` prop. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/*
      Vercel Web Analytics. No site key and no account wiring: the project is
      already on Vercel, so enabling Analytics in the dashboard is the whole
      setup. Cookieless and IP-anonymised, so it needs no consent banner.

      It also needs no CSP change, which is the reason it is a clean starting
      point. Vercel proxies both halves through our own origin - the script is
      served from /_vercel/insights/script.js and events POST to
      /_vercel/insights/view - so the existing `script-src 'self'` and
      `connect-src 'self'` already cover it. Nothing third-party is contacted
      from the browser.

      Ahrefs Web Analytics is planned post-launch and is the one that breaks
      out an `llm` source channel (assistant referrals - see
      docs/creative-bandit-launch-readiness.md §7.4). That one IS third-party
      and WILL need analytics.ahrefs.com added to script-src and connect-src
      in vercel.json. Adding it without touching the CSP fails silently in
      production while working fine in `astro dev`, which serves no CSP.
    */}
    <Analytics />
  </head>
  <body class="bg-base text-paper flex flex-col min-h-screen">
    <!--
      First focusable thing on the page. Every page carries a fixed header
      with five controls in it, so without this a keyboard or screen-reader
      user tabs through the logo, four nav items and the CTA before reaching
      any content - on all sixteen pages.

      Off-screen rather than `hidden`, because a display:none element cannot
      receive focus and the link would never appear.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink-acid focus:px-4 focus:py-3 focus:font-mono focus:text-sm focus:font-bold focus:uppercase focus:tracking-[0.12em] focus:text-base"
    >
      Skip to content
    </a>
    <div class="page-wash"></div>
    <Navbar />
    <main id="main" class="flex-grow">
      <slot />
    </main>
    <Footer />

    <script>
      // Navigation mobile menu toggle
      document.addEventListener('DOMContentLoaded', () => {
        const navToggle = document.getElementById('navToggle');
        const navMenu = document.getElementById('navMenu');

        if (navToggle && navMenu) {
          const setOpen = (open: boolean) => {
            navMenu.classList.toggle('hidden', !open);
            navMenu.classList.toggle('flex', open);
            // Keep the announced state in step with the visual one. These
            // must not drift; the attribute is the only signal a screen
            // reader gets, since the menu is hidden by class rather than by
            // the hidden attribute.
            navToggle.setAttribute('aria-expanded', String(open));
          };

          navToggle.addEventListener('click', () => {
            setOpen(navMenu.classList.contains('hidden'));
          });

          // Escape closes it and returns focus to the control that opened
          // it, rather than stranding the caret inside a menu that is no
          // longer on screen.
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !navMenu.classList.contains('hidden')) {
              setOpen(false);
              navToggle.focus();
            }
          });
        }
      });
    </script>
  </body>
</html>
