---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Our Work" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 bg-base/90 backdrop-blur-md">
  <div class="container mx-auto py-4">
    <nav class="flex items-center justify-between">
      <a href="/" class="group flex items-center gap-3" aria-label="Creative Bandit, home">
        <img
          src="/mascot/bandit-cat-head.svg"
          alt=""
          width="43"
          height="36"
          class="h-9 w-auto group-hover:animate-plate-jitter"
        />
        <span class="font-display text-xl font-extrabold uppercase tracking-tight text-paper" style="font-stretch: 125%;">
          Creative<span class="text-ink-hot">Bandit</span>
        </span>
      </a>
      
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class={`nav-link ${currentPath === item.href ? 'nav-link-active' : ''}`}
          >
            {item.label}
          </a>
        ))}
        <a href="/contact" class="ml-4 btn-primary">Book a Free Call</a>
      </div>
      
      <!-- Mobile Nav Toggle -->
      <button id="navToggle" class="md:hidden flex items-center px-3 py-2 border rounded text-paper-mute border-paper-mute hover:text-ink-hot hover:border-ink-hot transition-colors duration-300">
        <svg class="fill-current h-4 w-4" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <title>Menu</title>
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/>
        </svg>
      </button>
    </nav>
    
    <!-- Mobile Menu -->
    <div id="navMenu" class="hidden md:hidden flex-col py-4 mt-2 space-y-2">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`block px-4 py-2 transition-colors duration-300 hover:bg-base-100 hover:text-ink-hot ${currentPath === item.href ? 'text-ink-hot' : 'text-paper'}`}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="block mt-4 text-center btn-primary">Book a Free Call</a>
    </div>
  </div>
</header>
<div class="h-16"></div> <!-- Spacer for fixed header -->