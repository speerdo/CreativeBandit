---
import Logo from './Logo.astro';

/*
 * The scan sits in the nav rather than replacing the "Book a Free Call" CTA,
 * because the two asks serve different readiness stages: the scan is the
 * no-commitment entry point the homepage calls "start here", and the call is
 * the commitment. Before this it was reachable only from the homepage, while
 * every other page pushed the higher-friction ask - see
 * docs/creative-bandit-launch-readiness.md §9.2.
 *
 * The mobile menu renders from this same array, so it inherits automatically.
 */
const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Our Work" },
  { href: "/scan", label: "Free Scan" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 bg-base/90 backdrop-blur-md">
  <div class="container mx-auto py-4">
    <nav class="flex items-center justify-between">
      <!--
        Horizontal lockup on web, vertical (stacked) on mobile, per the brand
        drop. Both are rendered and one is hidden by breakpoint rather than
        swapped at runtime: the SVG is inlined at build time, so there is no
        second request to save and no layout shift while a script decides.
      -->
      <a href="/" class="cb-logo--link flex items-center" aria-label="Creative Bandit, home">
        <Logo variant="horizontal" class="hidden sm:inline-block" />
        <Logo variant="vertical" class="sm:hidden" />
      </a>
      
      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center space-x-1">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class={`nav-link ${currentPath === item.href ? 'nav-link-active' : ''}`}
          >
            {item.label}
          </a>
        ))}
        <a href="/contact" class="ml-4 btn-primary">Book a Free Call</a>
      </div>
      
      <!-- Mobile Nav Toggle -->
      <!-- aria-expanded is flipped by the toggle handler in Layout.astro.
           Without it the menu opens and closes with no announcement, so a
           screen-reader user cannot tell which state they are in. -->
      <button
        id="navToggle"
        type="button"
        aria-expanded="false"
        aria-controls="navMenu"
        aria-label="Menu"
        class="md:hidden flex items-center px-3 py-2 border rounded text-paper-mute border-paper-mute hover:text-ink-hot hover:border-ink-hot transition-colors duration-300"
      >
        <svg class="fill-current h-4 w-4" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <title>Menu</title>
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/>
        </svg>
      </button>
    </nav>
    
    <!-- Mobile Menu -->
    <div id="navMenu" class="hidden md:hidden flex-col py-4 mt-2 space-y-2">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`block px-4 py-2 transition-colors duration-300 hover:bg-base-100 hover:text-ink-hot ${currentPath === item.href ? 'text-ink-hot' : 'text-paper'}`}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="block mt-4 text-center btn-primary">Book a Free Call</a>
    </div>
  </div>
</header>
<!--
  Spacer for the fixed header, and it has to track the header's real height.
  Below sm the stacked lockup is taller than the horizontal one, putting the
  header at ~88px against ~68px above sm. A flat h-16 here let the top of
  every mobile page sit underneath the nav.
-->
<div class="h-24 sm:h-16"></div>