---
/*
 * Star-sight shooter: saucers drift across a field, you shoot them down with
 * the star-sight, the panel counts hits.
 *
 * Vanilla JS on purpose. §9 of the visual identity doc already flags that
 * ExitPopup and AnimatedStats pull a 182KB React runtime for a few KB of
 * component; adding a toy to that bill would be worse. This ships as a single
 * bundled module with no runtime.
 */
export interface Props {
  /** Sizing/positioning utilities for the wrapper. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['cb-shooter', className]} aria-labelledby="cb-shooter-title" data-shooter>
  <div class="cb-shooter__head">
    <div>
      <p class="label-tech mb-2">Target practice</p>
      <h3 id="cb-shooter-title" class="text-xl font-bold">Bandit Range</h3>
    </div>
    <!--
      aria-live so the running total is announced as it changes. The field
      itself is aria-hidden: a drifting saucer is not something a screen
      reader can usefully narrate, and the score is the only real state.
    -->
    <p class="cb-shooter__hud" aria-live="polite">
      <span class="cb-shooter__score" data-score>0</span>
      <span class="cb-shooter__best">Best <span data-best>0</span></span>
    </p>
  </div>

  <div class="cb-shooter__field" data-field aria-hidden="true">
    <!--
      Saucer template. The artwork is the craft from bandit-cat-batting.svg,
      re-centred on the origin so the script can place it by translate() alone
      rather than juggling the baked Illustrator transforms.
    -->
    <template data-ufo-template>
      <button class="cb-shooter__ufo" type="button" tabindex="-1" aria-hidden="true">
        <svg viewBox="-40 -24 80 48" role="presentation" focusable="false">
          <g transform="translate(-358.5 -99.5)">
            <ellipse fill="#ede8df" cx="361.7" cy="94.2" rx="14.3" ry="16.2" transform="translate(138.9 394.3) rotate(-68)"/>
            <ellipse fill="#1b27e8" cx="358.7" cy="101.3" rx="11.4" ry="39.9" transform="translate(130.4 396) rotate(-68)"/>
            <circle fill="#ffe800" cx="338.9" cy="97.3" r="3.4"/>
            <circle fill="#ffe800" cx="357" cy="105.6" r="3.4"/>
            <circle fill="#ffe800" cx="375.9" cy="112.2" r="3.4"/>
          </g>
        </svg>
      </button>
    </template>

    <p class="cb-shooter__prompt" data-prompt>
      <button class="btn-primary" type="button" data-start>Open fire</button>
    </p>
  </div>
</section>

<script>
  /*
   * One instance per element on the page, so the module does not assume it is
   * a singleton. Everything below is scoped to a single `[data-shooter]`.
   */
  /*
   * Movement model: a fly, not a blimp.
   *
   * Each craft carries a steady base drift plus a BURST that decays away in
   * under a tenth of a second. Every couple of hundred milliseconds it darts
   * again - a new burst, in a new direction. That dart-decay-dart cycle is
   * what reads as an insect; a constant velocity, however fast, just reads as
   * a fast blimp.
   *
   * The base drift always points the way the craft entered, so however wildly
   * it jinks it still crosses the field and eventually leaves.
   */
  type Ufo = {
    el: HTMLButtonElement;
    x: number;
    y: number;
    /** Steady travel, in px/sec. Sign is the direction of entry. */
    baseVx: number;
    /** Decaying dart, in px/sec. Re-set on every dart. */
    burstX: number;
    burstY: number;
    /** Timestamp of the next dart, in ms of animation time. */
    nextDart: number;
    dead: boolean;
  };

  /*
   * The whole feel lives in these six numbers, so they are grouped rather
   * than scattered through the code. Simulated over 200 crossings of a
   * 700x394 field, this set gives a ~2.6s traverse with about 13 darts on the
   * way and peaks near 680px/s.
   *
   * To dial it: SPEED_* changes how fast the field clears, DART_* how frantic
   * the jinking is, THROW how far it wanders off its line. Halving
   * BURST_DECAY_MS makes each dart snappier and shorter.
   */
  const DART_MIN = 100;
  const DART_MAX = 280;
  const BURST_DECAY_MS = 90;
  const SPEED_MIN = 170;
  const SPEED_MAX = 300;
  const THROW = 860;

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');
  const BEST_KEY = 'cb-shooter-best';

  /* localStorage throws outright in some privacy modes, so every access is
     guarded. A lost high score is not worth breaking the page over. */
  function readBest(): number {
    try {
      return Number(localStorage.getItem(BEST_KEY)) || 0;
    } catch {
      return 0;
    }
  }
  function writeBest(value: number): void {
    try {
      localStorage.setItem(BEST_KEY, String(value));
    } catch {
      /* ignore */
    }
  }

  function setup(root: HTMLElement): void {
    const field = root.querySelector<HTMLElement>('[data-field]');
    const tpl = root.querySelector<HTMLTemplateElement>('[data-ufo-template]');
    const scoreEl = root.querySelector<HTMLElement>('[data-score]');
    const bestEl = root.querySelector<HTMLElement>('[data-best]');
    const prompt = root.querySelector<HTMLElement>('[data-prompt]');
    const startBtn = root.querySelector<HTMLButtonElement>('[data-start]');
    if (!field || !tpl || !scoreEl || !bestEl || !prompt || !startBtn) return;

    const ufos: Ufo[] = [];
    let score = 0;
    let best = readBest();
    let running = false;
    let raf = 0;
    let last = 0;
    let sinceSpawn = 0;
    bestEl.textContent = String(best);

    function spawn(): void {
      const r = field!.getBoundingClientRect();
      if (r.width === 0) return;

      const node = tpl!.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
      const fromLeft = Math.random() < 0.5;
      /* Spawned clear of the edges rather than at them, so a saucer never
         materialises half-visible on the boundary. */
      const size = 40 + Math.random() * 22;
      const y = 12 + Math.random() * Math.max(1, r.height - size - 24);

      const ufo: Ufo = {
        el: node,
        x: fromLeft ? -size : r.width + size,
        y,
        baseVx: (SPEED_MIN + Math.random() * (SPEED_MAX - SPEED_MIN)) * (fromLeft ? 1 : -1),
        burstX: 0,
        burstY: 0,
        nextDart: 0,
        dead: false,
      };

      node.style.width = `${size}px`;
      /* The craft flies nose-first, so it faces its direction of travel. */
      node.style.setProperty('--cb-ufo-face', fromLeft ? '-1' : '1');
      node.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        hit(ufo);
      });

      field!.appendChild(node);
      ufos.push(ufo);
      place(ufo);
    }

    function place(u: Ufo): void {
      u.el.style.transform = `translate(${u.x}px, ${u.y}px)`;
    }

    /* A new dart: a hard kick in a fresh direction, mostly sideways but with
       real vertical throw, which is what stops it looking like a hover. */
    function dart(u: Ufo, now: number): void {
      const dir = Math.sign(u.baseVx) || 1;
      u.burstX = dir * (200 + Math.random() * 280);
      u.burstY = (Math.random() - 0.5) * THROW;
      u.nextDart = now + DART_MIN + Math.random() * (DART_MAX - DART_MIN);
    }

    function hit(u: Ufo): void {
      if (u.dead || !running) return;
      u.dead = true;
      score += 1;
      scoreEl!.textContent = String(score);
      if (score > best) {
        best = score;
        bestEl!.textContent = String(best);
        writeBest(best);
      }
      u.el.classList.add('is-hit');
      /* Let the burst play out, then drop the node. The flag above means a
         second click in that window cannot double-count. */
      window.setTimeout(() => u.el.remove(), 320);
    }

    function frame(now: number): void {
      if (!running) return;
      const dt = last ? Math.min(now - last, 64) : 16;
      last = now;
      const r = field!.getBoundingClientRect();

      sinceSpawn += dt;
      const live = ufos.filter((u) => !u.dead).length;
      if (sinceSpawn > 620 && live < 6) {
        sinceSpawn = 0;
        spawn();
      }

      /* Exponential decay, framerate-independent: a burst loses the same
         fraction per millisecond however often frames arrive. */
      const decay = Math.exp(-dt / BURST_DECAY_MS);

      for (const u of ufos) {
        if (u.dead) continue;

        if (now >= u.nextDart) dart(u, now);
        u.burstX *= decay;
        u.burstY *= decay;

        u.x += ((u.baseVx + u.burstX) * dt) / 1000;
        u.y += (u.burstY * dt) / 1000;

        /* Bounce off the top and bottom rather than clamping: a fly that
           slides along the ceiling looks stuck, one that rebounds does not. */
        const maxY = Math.max(0, r.height - u.el.offsetHeight);
        if (u.y < 0) {
          u.y = 0;
          u.burstY = Math.abs(u.burstY);
        } else if (u.y > maxY) {
          u.y = maxY;
          u.burstY = -Math.abs(u.burstY);
        }

        place(u);
        /* Off the far side: retire it. Without this the array grows for as
           long as the panel is open. */
        if (u.x < -160 || u.x > r.width + 160) {
          u.dead = true;
          u.el.remove();
        }
      }
      for (let i = ufos.length - 1; i >= 0; i--) {
        if (ufos[i].dead && !ufos[i].el.isConnected) ufos.splice(i, 1);
      }

      raf = window.requestAnimationFrame(frame);
    }

    function start(): void {
      if (running) return;
      running = true;
      score = 0;
      scoreEl!.textContent = '0';
      root.classList.add('is-running');
      prompt!.hidden = true;

      if (REDUCED.matches) {
        /*
         * No animation loop at all. The saucers are placed once and stay put,
         * so the panel is still a thing you can shoot rather than a dead
         * rectangle - it just does not move.
         */
        for (let i = 0; i < 5; i++) spawn();
        for (const u of ufos) {
          const r = field!.getBoundingClientRect();
          u.x = 20 + Math.random() * Math.max(1, r.width - 100);
          place(u);
        }
        return;
      }

      last = 0;
      sinceSpawn = 620;
      raf = window.requestAnimationFrame(frame);
    }

    function stop(): void {
      running = false;
      window.cancelAnimationFrame(raf);
      for (const u of ufos) u.el.remove();
      ufos.length = 0;
      root.classList.remove('is-running');
      prompt!.hidden = false;
    }

    startBtn.addEventListener('click', start);

    /* Nothing should be burning frames for a panel nobody is looking at. */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && running) {
        window.cancelAnimationFrame(raf);
      } else if (!document.hidden && running && !REDUCED.matches) {
        last = 0;
        raf = window.requestAnimationFrame(frame);
      }
    });

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (!entry.isIntersecting && running) stop();
      },
      { threshold: 0 }
    );
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-shooter]').forEach(setup);
</script>
