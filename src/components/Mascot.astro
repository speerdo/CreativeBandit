---
import fs from 'node:fs';
import path from 'node:path';

export type Pose = 'sleeping' | 'pistols' | 'batting' | 'rocket';

export interface Props {
  pose: Pose;
  /** Sizing/visibility utilities for the wrapper. */
  class?: string;
  /** Accessible name. Omit for decorative use (the default). */
  label?: string;
  /** Film-grain strength, 0-1. 0 leaves the artwork clean. */
  grain?: number;
}

const { pose, class: className = '', label, grain = 0.32 } = Astro.props;
const grainAlpha = Math.max(0, Math.min(1, grain));

/*
 * Spelled out rather than built as `cb-mascot--${pose}`. Tailwind finds the
 * classes to keep by scanning source text for literals, so an interpolated
 * name is invisible to it and every per-pose rule gets purged - the hover
 * animations silently do nothing while the markup still looks correct.
 */
const POSE_CLASS: Record<Pose, string> = {
  sleeping: 'cb-mascot--sleeping',
  pistols: 'cb-mascot--pistols',
  batting: 'cb-mascot--batting',
  rocket: 'cb-mascot--rocket',
};

/*
 * The SVG is inlined rather than used via <img> because CSS cannot reach
 * inside an <img>-loaded document - :hover on the page can't drive a
 * transform on a path in there. Inlining is what makes the hover animation
 * possible at all.
 *
 * Inlining brings two problems, both handled below:
 *
 *  1. Illustrator names every class st0..stN and every id `clippath`,
 *     `bch-halftone` and so on. Two mascots on one page would collide and
 *     restyle each other, so both are namespaced per pose.
 *
 *  2. The artwork has no layer names, so animatable parts are addressed by
 *     their index in document order. That is brittle by nature, so each
 *     entry carries the fill and bbox it expects and the build fails loudly
 *     if the artwork moves underneath it - far better than silently
 *     animating a boot instead of a tail.
 *
 * If these get re-exported from Illustrator, naming the layers there would
 * let us drop the index map entirely and target real ids instead.
 */
interface PartSpec {
  /** Index in document order over path/circle/ellipse/rect/polygon, defs included. */
  index: number;
  /** Expected paint. Verified at build time - see the check below. */
  paint: string;
  /** Rounded bbox in the artwork's own units. Documentation for whoever has
   *  to re-derive this map by hand; not machine-checked. */
  box: [number, number, number, number];
}

const PARTS: Record<Pose, Record<string, PartSpec[]>> = {
  pistols: {
    tail: [{ index: 5, paint: '#d8d2c6', box: [113, 98, 280, 282] }],
    'arm-left': [{ index: 12, paint: 'stroke', box: [15, 151, 84, 211] }],
    'arm-right': [{ index: 6, paint: 'stroke', box: [197, 151, 266, 210] }],
    hat: [
      { index: 25, paint: '#1b27e8', box: [28, 36, 253, 81] },
      { index: 26, paint: '#0b0b0c', box: [28, 66, 253, 88] },
      // Brim detail. Left out of the first pass, so they stayed put while the
      // rest of the hat moved and the brim visibly came apart.
      { index: 31, paint: '#1b27e8', box: [182, 21, 199, 100] },
      { index: 32, paint: '#1b27e8', box: [51, 52, 130, 69] },
      { index: 33, paint: '#1b27e8', box: [94, -1, 187, 58] },
      { index: 34, paint: '#0b0b0c', box: [95, 43, 186, 55] },
      { index: 35, paint: '#ffe800', box: [112, 41, 123, 56] },
    ],
  },
  batting: {
    tail: [{ index: 8, paint: '#d8d2c6', box: [0, 122, 206, 279] }],
    'arm-swipe': [{ index: 9, paint: 'stroke', box: [202, 53, 260, 130] }],
    paw: [
      { index: 19, paint: '#ede8df', box: [232, 30, 276, 74] },
      { index: 20, paint: '#e8451f', box: [234, 41, 244, 51] },
      { index: 21, paint: '#e8451f', box: [245, 32, 255, 42] },
      { index: 22, paint: '#e8451f', box: [259, 37, 269, 47] },
    ],
    ufo: [
      { index: 25, paint: '#ede8df', box: [347, 78, 376, 110] },
      { index: 26, paint: '#1b27e8', box: [347, 61, 370, 141] },
      { index: 27, paint: '#ffe800', box: [336, 94, 342, 101] },
      { index: 28, paint: '#ffe800', box: [354, 102, 360, 109] },
      { index: 29, paint: '#ffe800', box: [372, 109, 379, 116] },
    ],
    spark: [
      { index: 30, paint: 'stroke', box: [401, 57, 419, 69] },
      { index: 31, paint: 'stroke', box: [409, 93, 431, 95] },
      { index: 32, paint: 'stroke', box: [399, 127, 417, 137] },
    ],
  },
  sleeping: {
    ear: [
      { index: 19, paint: '#ede8df', box: [26, 17, 66, 62] },
      { index: 20, paint: '#e8451f', box: [35, 28, 60, 59] },
    ],
    tail: [{ index: 34, paint: '#ede8df', box: [114, 96, 291, 156] }],
  },
  rocket: {
    // The whole exhaust plume is one polygon, attached at its left edge
    // (x=850) on the craft's tail. Nothing else here moves: the hover nudge
    // is applied to the root svg, not to a part.
    flame: [{ index: 6, paint: '#ffe800', box: [850, 237, 1318, 465] }],
  },
};

/*
 * Parts that need a second animation channel. Two transforms cannot stack on
 * one element, so these get an inner group as well as the outer one: the
 * outer carries the motion the pose is built around, the inner an
 * independent drift on a different period, and the two compose.
 *
 * It has to be a nested group rather than the elements themselves. The
 * saucer's dome and body carry baked translate+rotate attributes from
 * Illustrator, and giving those elements a `transform-box` re-anchors the
 * attribute they already have - the saucer leaves the canvas entirely. A
 * bare <g> owns no transform, so there is nothing to re-anchor.
 */
/*
 * Backdrops, drawn behind the cat.
 *
 * A scene is a separate file rather than more shapes inside the mascot for
 * two reasons: the artwork stays something Illustrator can reopen untouched,
 * and the scenery stays still while the cat squashes and swings above it. A
 * hill that coils with the cat's jump is worse than no hill.
 *
 * The box is stated in the POSE's own units, so a scene can reach outside the
 * mascot's bounds - the numbers below are read straight off the scene file's
 * viewBox and turned into percentages of the mascot underneath.
 */
const SCENERY: Partial<
  Record<Pose, { file: string; x: number; y: number; w: number; h: number; front?: boolean }>
> = {
  pistols: { file: 'scene-pistols.svg', x: -130, y: 150, w: 425, h: 217 },
  // The burst is thrown off the cat rather than standing behind it, so this
  // one layers in front. Its strokes all sit outside the head's silhouette,
  // so nothing of the artwork is covered.
  batting: { file: 'scene-batting.svg', x: -40, y: -90, w: 280, h: 230, front: true },
};

const STACKED: Partial<Record<Pose, string[]>> = {
  batting: ['ufo'],
  rocket: ['flame'],
};

const file = path.join(process.cwd(), 'public', 'mascot', `bandit-cat-${pose}.svg`);
let svg = fs.readFileSync(file, 'utf8');

/* --- film grain -----------------------------------------------------------
 *
 * The page-wide grain on `body::after` is a baked PNG on purpose: a
 * viewport-sized live filter would re-evaluate noise on every paint. At
 * mascot size that objection doesn't hold, and a real filter buys two things
 * a tiled PNG cannot. It clips the noise to the artwork's own alpha, so the
 * grain bites into the cat rather than sitting over its bounding box, and it
 * re-renders with the hover animations instead of staying put while the tail
 * swings out from under it.
 *
 * Cost is a filter re-run per frame on the mascot being hovered. Three small
 * mascots, one hovered at a time - if that ever changes, the cheaper route is
 * a `::after` carrying /textures/grain.png masked by the pose SVG, which
 * gives up on tracking the animation.
 *
 * Injected before the namespacing pass below so the `grain` id and its
 * `url(#grain)` reference get rewritten per pose along with everything else.
 */

/*
 * Speckle size is set in artwork units, but what matters is how big a speckle
 * lands on screen, so the frequency is per pose: roughly the scale the pose
 * renders at, divided by the ~1.5px speckle we want. The first three sit
 * around 0.4x-0.6x and share a value. The rocket's viewBox is 1317 units wide
 * against a ~280px placement, so it renders near 0.2x - left at 0.35 its
 * grain lands under a pixel and turns to mush. Retune if a placement's width
 * changes much.
 */
const GRAIN_FREQUENCY: Record<Pose, number> = {
  sleeping: 0.35,
  pistols: 0.35,
  batting: 0.35,
  rocket: 0.14,
};
const GRAIN_OCTAVES = 3;
// Per pose, so two mascots sharing a page don't carry identical speckles.
const GRAIN_SEED: Record<Pose, number> = {
  sleeping: 7,
  pistols: 19,
  batting: 31,
  rocket: 47,
};
// Contrast around mid-gray. fractalNoise clusters tightly on 0.5 and reads as
// a flat wash without it.
const GRAIN_CONTRAST = 1.6;

if (grainAlpha > 0) {
  // One matrix does three jobs: average the channels to gray, stretch that
  // gray around 0.5, and flatten alpha to a constant. Mid-gray is the
  // identity for `overlay`, so only the deviations show up as grain.
  const w = (GRAIN_CONTRAST / 3).toFixed(4);
  const offset = (0.5 - 0.5 * GRAIN_CONTRAST).toFixed(4);
  const row = `${w} ${w} ${w} 0 ${offset}`;
  const matrix = `${row} ${row} ${row} 0 0 0 0 ${grainAlpha}`;

  // sRGB rather than the linearRGB default: linear washes the noise out and
  // pays for two colour-space conversions to do it.
  const filter =
    `<filter id="grain" x="-5%" y="-5%" width="110%" height="110%" ` +
    `color-interpolation-filters="sRGB">` +
    `<feTurbulence type="fractalNoise" baseFrequency="${GRAIN_FREQUENCY[pose]}" ` +
    `numOctaves="${GRAIN_OCTAVES}" seed="${GRAIN_SEED[pose]}" result="noise"/>` +
    `<feColorMatrix in="noise" type="matrix" values="${matrix}" result="speckle"/>` +
    // Clip to the silhouette. Without this the grain fills the filter region
    // and the cat arrives in a grey box.
    `<feComposite in="speckle" in2="SourceAlpha" operator="in" result="clipped"/>` +
    // `in` is the top layer, `in2` the backdrop - grain over artwork.
    `<feBlend in="clipped" in2="SourceGraphic" mode="overlay"/>` +
    `</filter>`;

  const CLOSE = '</defs>';
  const defsEnd = svg.indexOf(CLOSE);
  if (defsEnd === -1) {
    throw new Error(
      `Mascot "${pose}": no <defs> to hang the grain filter on. The artwork has ` +
        `been re-exported without one - add the filter by hand or pass grain={0}.`
    );
  }

  svg = svg.slice(0, defsEnd) + filter + svg.slice(defsEnd);

  /*
   * Everything after </defs> goes into one filtered group rather than the
   * filter going on the root <svg>. On the root, the filter region is the SVG
   * viewport, which would clip the parts of the artwork that `overflow-visible`
   * exists to let out. On a group the region is the group's own bbox, so it
   * tracks whatever the children actually cover, hover transforms included.
   *
   * The wrapper is balanced around the whole body, so it leaves the <g> counts
   * between any two drawables untouched and the group-boundary check below
   * still measures what it means to.
   */
  const bodyStart = svg.indexOf(CLOSE) + CLOSE.length;
  const bodyEnd = svg.lastIndexOf('</svg>');
  svg =
    svg.slice(0, bodyStart) +
    `<g filter="url(#grain)">` +
    svg.slice(bodyStart, bodyEnd) +
    `</g>` +
    svg.slice(bodyEnd);
}

// --- namespace classes and ids so two mascots can share a page ------------
svg = svg.replace(/\b(st\d+)\b/g, `${pose}-$1`);
const ids = [...svg.matchAll(/\bid="([^"]+)"/g)].map((m) => m[1]);
for (const id of ids) {
  if (id.startsWith(`${pose}-`)) continue;
  const esc = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  svg = svg.replace(new RegExp(`id="${esc}"`, 'g'), `id="${pose}-${id}"`);
  svg = svg.replace(new RegExp(`url\\(#${esc}\\)`, 'g'), `url(#${pose}-${id})`);
  svg = svg.replace(new RegExp(`href="#${esc}"`, 'g'), `href="#${pose}-${id}"`);
}

// --- tag animatable parts, verifying each is still what we think it is ----
const DRAWABLE = /<(path|circle|ellipse|rect|polygon)\b[^>]*?\/?>/g;
const spans = [...svg.matchAll(DRAWABLE)].map((m) => ({
  open: m.index! + m[0].indexOf(m[1]) + m[1].length, // just after the tag name
  start: m.index!,
  end: m.index! + m[0].length,
}));
const offsets = spans.map((s) => s.open);

// Resolve each Illustrator class to the paint it actually carries, so the
// index map can be checked rather than merely hoped at.
const classPaint = new Map<string, string>();
const styleBlock = svg.match(/<style>([\s\S]*?)<\/style>/);
if (styleBlock) {
  for (const [, selector, body] of styleBlock[1].matchAll(/([^{}]+)\{([^{}]+)\}/g)) {
    const fill = body.match(/fill:\s*([^;]+)/);
    const stroke = body.match(/stroke:\s*([^;]+)/);
    for (const one of selector.split(',')) {
      const key = one.trim().replace(/^\./, '');
      if (!key) continue;
      const prev = classPaint.get(key);
      const next = fill ? fill[1].trim() : undefined;
      if (next && next !== 'none') classPaint.set(key, next);
      else if (stroke) classPaint.set(key, 'stroke');
      else if (next && !prev) classPaint.set(key, next);
    }
  }
}

const elements = [...svg.matchAll(/<(path|circle|ellipse|rect|polygon)\b([^>]*)>/g)];

// Verification pass only - the wrapping below re-walks PARTS itself.
for (const [part, specs] of Object.entries(PARTS[pose])) {
  for (const spec of specs) {
    if (spec.index >= offsets.length) {
      throw new Error(
        `Mascot "${pose}": part "${part}" wants element ${spec.index} but the ` +
          `artwork only has ${offsets.length}. It has been re-exported - ` +
          `re-derive the part map before trusting these indices.`
      );
    }
    const attrs = elements[spec.index]?.[2] ?? '';
    // Selectors were namespaced along with the elements, so look the class
    // up exactly as it now appears - stripping the prefix misses every time.
    const cls = attrs.match(/class="([^"]+)"/)?.[1] ?? '';
    const inline = attrs.match(/fill="([^"]+)"/)?.[1];
    const actual = (inline && inline !== 'none' ? inline : classPaint.get(cls)) ?? '(none)';
    if (actual.toLowerCase() !== spec.paint.toLowerCase()) {
      throw new Error(
        `Mascot "${pose}": element ${spec.index} was mapped to part "${part}" ` +
          `expecting paint ${spec.paint}, but it paints ${actual}. The artwork ` +
          `has changed underneath the part map - re-derive it rather than ` +
          `animating the wrong shape.`
      );
    }
  }
}

/*
 * A part made of several contiguous elements is WRAPPED in a group rather
 * than having every element tagged. Two reasons, both of which bit:
 *
 *  - Illustrator bakes placement into `transform` attributes on some shapes
 *    (the batting UFO's dome and body carry translate+rotate). A CSS
 *    transform replaces the attribute rather than composing with it, so
 *    animating those elements directly threw the UFO across the canvas.
 *
 *  - With `transform-box: fill-box`, a rotation applied to each element
 *    spins each about its own centre, so a multi-part object shears apart
 *    instead of tipping as one body.
 *
 * Wrapping sidesteps both: the group has no transform of its own and its
 * children keep theirs. Non-contiguous parts (the pistols hat) stay
 * per-element and must only ever be given uniform transforms - a translate
 * is fine, a rotate is not.
 */
type Insert = { pos: number; text: string };
const inserts: Insert[] = [];

for (const [part, specs] of Object.entries(PARTS[pose])) {
  const ids = specs.map((sp) => sp.index).sort((a, b) => a - b);
  const contiguous = ids.every((v, k) => v === ids[0] + k);
  const stacked = (STACKED[pose] ?? []).includes(part);

  if (stacked && !contiguous) {
    throw new Error(
      `Mascot "${pose}": part "${part}" is marked for a stacked animation, but ` +
        `its elements are not contiguous so they cannot share one inner group. ` +
        `Re-order the artwork, or drop it from STACKED and find another way to ` +
        `compose the two transforms.`
    );
  }

  const open = stacked
    ? `<g data-cb="${part}"><g data-cb-drift="${part}">`
    : `<g data-cb="${part}">`;
  const close = stacked ? `</g></g>` : `</g>`;

  if (contiguous) {
    const first = spans[ids[0]];
    const last = spans[ids[ids.length - 1]];
    // Wrapping is only valid if the run does not straddle a group boundary.
    const between = svg.slice(first.start, last.end);
    const opens = (between.match(/<g\b/g) ?? []).length;
    const closes = (between.match(/<\/g>/g) ?? []).length;
    if (opens !== closes) {
      throw new Error(
        `Mascot "${pose}": part "${part}" spans a group boundary, so it cannot ` +
          `be wrapped. Re-check the part map against the artwork.`
      );
    }
    inserts.push({ pos: first.start, text: open });
    inserts.push({ pos: last.end, text: close });
  } else {
    // Non-contiguous parts get one wrapper each rather than the attribute
    // going on the element itself. A CSS transform REPLACES a baked
    // `transform` attribute instead of composing with it, and the pistols
    // hat band and buckle both carry one - tagging them directly threw the
    // band clean off the hat. Wrapping keeps the child's own transform
    // intact and animates the group above it.
    for (const id of ids) {
      inserts.push({ pos: spans[id].start, text: open });
      inserts.push({ pos: spans[id].end, text: close });
    }
  }
}

// Apply back-to-front so earlier positions stay valid.
for (const ins of inserts.sort((a, b) => b.pos - a.pos)) {
  svg = svg.slice(0, ins.pos) + ins.text + svg.slice(ins.pos);
}

// --- size the root and give it an accessible role ------------------------
const vb = svg.match(/viewBox="([\d.\-\s]+)"/);
const [, , vw, vh] = vb ? vb[1].split(/\s+/).map(Number) : [0, 0, 100, 100];

svg = svg.replace(
  /<svg\b([^>]*)>/,
  (_full, attrs: string) => {
    let a = attrs
      .replace(/\s(width|height)="[^"]*"/g, '')
      .replace(/\srole="[^"]*"/g, '')
      .replace(/\saria-[a-z]+="[^"]*"/g, '');
    return `<svg${a} width="${vw}" height="${vh}" ${
      label ? `role="img" aria-label="${label}"` : 'role="presentation" aria-hidden="true" focusable="false"'
    }>`;
  }
);
// The <title> would otherwise be announced even on a decorative instance.
if (!label) svg = svg.replace(/<title\b[^>]*>[\s\S]*?<\/title>/, '');

/*
 * Scene box to percentages of the mascot's own box. Both are stated in the
 * pose's units, so this is a straight ratio with no offsets to re-tune when a
 * placement's width changes - the scene simply scales with the cat.
 */
const scene = SCENERY[pose];
let sceneSvg = '';
let sceneStyle = '';
if (scene) {
  sceneSvg = fs.readFileSync(path.join(process.cwd(), 'public', 'mascot', scene.file), 'utf8');
  const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
  sceneStyle = [
    `left:${pct(scene.x / vw)}`,
    `width:${pct(scene.w / vw)}`,
    // Pinned by its bottom rather than its top, so a scene drawn to the same
    // ground line as the artwork sits flush against the cat's feet.
    `bottom:${pct((vh - (scene.y + scene.h)) / vh)}`,
    `height:${pct(scene.h / vh)}`,
  ].join(';');
}
---

<span class:list={['cb-mascot', POSE_CLASS[pose], className]}>
  {sceneSvg && (
    <span
      class:list={['cb-mascot__scene', scene?.front && 'cb-mascot__scene--front']}
      style={sceneStyle}
      set:html={sceneSvg}
    />
  )}
  <Fragment set:html={svg} />
</span>
