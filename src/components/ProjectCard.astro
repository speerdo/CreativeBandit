---
export interface Props {
  title: string;
  category: string;
  image: string;
  link: string;
  description?: string;
  /**
   * Overrides the default alt text. The default assumes the image is a site
   * screenshot, which it is for every client card - but not for the motion
   * reel, whose thumbnail is a logo mark.
   */
  imageAlt?: string;
}

const { title, category, image, link, description, imageAlt } = Astro.props;

const isExternal = link.startsWith('http');
---

<a
  href={link}
  class="project-card group block"
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
>
  <!--
    Screenshots run unfiltered. The duotone plate that used to sit here was
    justified as cover for stock filler (visual-identity 4.4); these are real
    sites now, and the point of the image is what the site actually looks
    like. The card carries the house style through its frame, mono label and
    acid CTA instead of by recolouring the artwork.
  -->
  <div class="relative overflow-hidden">
    <img
      src={image}
      alt={imageAlt ?? `${title} website screenshot`}
      loading="lazy"
      decoding="async"
      class="h-64 w-full object-cover object-top"
    />
  </div>

  <div class="overlay">
    <span class="label-tech">{category}</span>
    <h3 class="mt-2 text-xl font-bold">{title}</h3>
    {description && <p class="mt-2 text-sm text-paper-mute">{description}</p>}
    <div class="mt-3 flex items-center font-mono text-xs uppercase tracking-[0.14em] text-ink-acid">
      <span>View Project</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ml-2 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</a>
