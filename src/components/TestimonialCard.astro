---
export interface Props {
  quote: string;
  author: string;
  position: string;
  company: string;
}

const { quote, author, position, company } = Astro.props;
---

<!--
  Inverted: a bone paper slab on the dark page, so testimonials read as a
  printed quote poster rather than as one more dark card in the grid.
-->
<figure class="crop-marks flex h-full flex-col bg-paper p-8 text-base-300">
  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor" class="mb-5 text-ink-hot" aria-hidden="true">
    <path d="M9.983 3v7.391c0 5.704-3.731 9.57-8.983 10.609l-.995-2.151c2.432-.917 3.995-3.638 3.995-5.849h-4v-10h9.983zm14.017 0v7.391c0 5.704-3.748 9.571-9 10.609l-.996-2.151c2.433-.917 3.996-3.638 3.996-5.849h-3.983v-10h9.983z"/>
  </svg>

  <blockquote class="mb-8 flex-grow text-lg leading-relaxed">{quote}</blockquote>

  <figcaption class="border-t border-base-300/20 pt-4">
    <p class="font-display text-lg font-extrabold uppercase leading-none" style="font-stretch: 125%;">{author}</p>
    <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-base-300/70">{position}, {company}</p>
  </figcaption>
</figure>
