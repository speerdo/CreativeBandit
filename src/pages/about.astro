---
import DesertScene from '../components/DesertScene.astro';
import Layout from '../layouts/Layout.astro';
import TeamMember from '../components/TeamMember.astro';
import { person } from '../lib/schema';

const team = [
  {
    name: "Adam Speer",
    position: "Full-Stack Development & AI Automation",
    image: "/images/adam-dev-bandit.webp",
    bio: "8+ years building production applications for Fortune 500 companies and startups. Focused on AI-powered automation and full-stack systems that eliminate manual work and scale with the business."
  },
  {
    // TODO: last name
    name: "Katlyn",
    position: "Design & Motion Lead",
    image: "/images/katlyn-design-bandit.webp",
    bio: "10+ years creating design and motion work for local businesses and big household brands. Specialized in enhancing marketing material and brand assets to scale."
  }
];

const values = [
  {
    title: "Innovation",
    description: "We stay current with new technologies and pick the ones that solve real problems for our clients rather than chasing hype."
  },
  {
    title: "Authenticity",
    description: "We build brand work that reflects who you actually are and speaks plainly to the people you're trying to reach."
  },
  {
    title: "Excellence",
    description: "We sweat the details in every line of code and every client interaction, and hold our deliverables to a high bar."
  },
  {
    title: "Collaboration",
    description: "We work as true partners with our clients, with open communication and clear ownership throughout every project."
  },
  {
    title: "Impact",
    description: "We focus on work that moves real business results: less manual work, higher conversion, fewer errors, faster pages."
  },
  {
    title: "Creativity",
    description: "We approach every challenge with creative thinking and find solutions that fit the problem instead of forcing a template."
  }
];

// Calculate years of experience (started October 2017)
const startDate = new Date(2017, 9); // October 2017
const now = new Date();
let yearsExperience = now.getFullYear() - startDate.getFullYear();
if (now.getMonth() < 9) {
  yearsExperience -= 1;
}

const stats = [
  { value: `${yearsExperience}+`, label: "Years Experience" },
  { value: "20+", label: "Projects Completed" },
  { value: "10+", label: "Clients Served" },
  // Was "4x / Industry Conversion Avg" - the affiliate-conversion claim again,
  // which nothing we can show a reader substantiates. Replaced with the
  // first-party traffic figure for our own properties.
  { value: "10k+", label: "Monthly Visitors, Own Sites" }
];

const approach = [
  {
    step: "01",
    title: "Discovery & Strategy",
    description: "We start by understanding your business goals, target audience, and where the manual bottlenecks are, then map out a concrete plan."
  },
  {
    step: "02", 
    title: "Design & Development",
    description: "Katlyn handles the visual and motion work while Adam builds the application with modern, well-tested tools."
  },
  {
    step: "03",
    title: "Testing & Optimization",
    description: "We test every part of the build and optimize for performance, usability, and conversion across all devices."
  },
  {
    step: "04",
    title: "Launch & Growth",
    description: "We support your launch and keep optimizing so the work keeps paying off as the business grows."
  }
];
/*
 * Person is an entity type: it is what lets an assistant answer "who runs
 * this studio" from markup rather than by guessing at prose. Built from the
 * same array the page renders.
 */
const teamSchema = team.map((member) =>
  person({
    name: member.name,
    jobTitle: member.position,
    description: member.bio,
    image: member.image.startsWith('/') ? member.image : undefined,
  })
);
---

<Layout
  title="About"
  description="A two-person studio pairing full-stack development and AI automation with design and motion. Based in Indianapolis, working with agencies nationwide."
  schema={teamSchema}
>
  <!-- Hero Section -->
  <section class="section pt-24 relative">
    <div class="container mx-auto">
      <div class="max-w-4xl">
        <p class="label-tech mb-6">About Creative Bandit</p>
        <h1 class="mb-6">Full-Stack Development + <span class="plate-type">Design That Moves</span></h1>
        <p class="text-xl text-paper-mute mb-8">
          We're Creative Bandit: Adam on development and AI automation, Katlyn on design and motion. Together we build digital products that work as good as they look, and deliver measurable business impact.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary">Start Your Project</a>
          <a href="/work" class="btn-secondary">See Our Work</a>
        </div>
      </div>
    </div>
    
    <div class="absolute top-0 right-0 w-full h-full -z-10">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-ink-hot/10 to-transparent opacity-30"></div>
    </div>
  </section>
  
  <!-- About Us Section -->
  <!-- `cb-desert-host` makes the whole section the hover target for the
       saucer flyby, rather than the graphic alone. -->
  <section class="cb-desert-host py-20">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <!-- Lifted clear of the stats card below it. Only from lg up: below
               that the grid is a single column and the scene already has the
               full width of the page to itself. -->
          <div class="relative lg:-mt-14">
            <!--
              Was a hotlinked Pexels photo - one of the stock-image tells §1 of
              the visual identity doc names. The desert scene is the same
              vocabulary as the pistols cat's backdrop, so the page stops
              borrowing someone else's photograph to fill the column.

              aspect-[4/3] and not `aspect-w-4 aspect-h-3`: the latter is the
              old @tailwindcss/aspect-ratio plugin syntax, and that plugin is
              not installed, so those two classes were doing nothing at all.

              Widened past its column and bled to the LEFT, toward the page
              edge — the identity doc's "let it break the grid" note. Left
              rather than right because right is where the copy sits, and the
              gap between them is the one piece of breathing room the row has.
              body carries overflow-x-hidden, so the bleed cannot raise a
              horizontal scrollbar.
            -->
            <div class="aspect-[4/3] overflow-hidden lg:-ml-[12%] lg:w-[112%]">
              <DesertScene class="h-full w-full" />
            </div>
            <div class="absolute -bottom-6 -right-6 bg-base-100 p-6 shadow-xl">
              <div class="grid grid-cols-2 gap-6">
                {stats.slice(0, 2).map(stat => (
                  <div class="text-center">
                    <p class="text-2xl font-bold plate-type">{stat.value}</p>
                    <p class="text-paper-mute text-xs">{stat.label}</p>
                  </div>
                ))}
                {stats.slice(2, 4).map(stat => (
                  <div class="text-center">
                    <p class="text-2xl font-bold plate-type">{stat.value}</p>
                    <p class="text-paper-mute text-xs">{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        
        <div>
          <p class="label-tech mb-4">Our Story</p>
          <h2 class="mb-6">From Enterprise to <span class="plate-type">AI Automation</span></h2>
          <p class="mb-6 text-paper-mute">
            With 8+ years of full-stack development experience, we've built production applications for Fortune 500 companies including Eli Lilly and Salesforce, as well as mission-driven startups in healthcare and education. Our background spans pharmaceutical web applications, HIPAA-compliant healthcare systems, and SaaS platforms serving thousands of users.
          </p>
          <p class="mb-6 text-paper-mute">
            Today, we focus on AI-powered automation systems using OpenAI, Anthropic, and Google Gemini APIs. Recent projects include AI verification systems achieving 97% accuracy, automated content and SEO pipelines, and healthcare compliance automation for Medicare billing.
          </p>
          {/*
            The affiliate-conversion and monthly-transaction figures that used
            to close these two paragraphs came from Amazon Associates and an ad
            network, and nothing we can point a reader at substantiates them.
            They were pulled from /work in the launch pass for that reason, so
            they cannot survive here either. Replaced with the traffic and
            ranking numbers, which are first-party and checkable - see
            docs/creative-bandit-launch-readiness.md §7.
          */}
          <p class="mb-6 text-paper-mute">
            Beyond client work, we build and operate our own web properties: DowntownDry, a nationwide alcohol-free venue directory, and RecycleOldTech.com, an electronics recycling directory that an automated content pipeline took from zero to 85 top-ten rankings and over 10,000 visitors a month in fourteen months.
          </p>
          <div class="bg-base-200 p-6">
            <p class="text-ink-hot font-semibold mb-2">Our Focus</p>
            <p class="text-paper-mute">Building intelligent systems that eliminate manual work and deliver measurable business impact, whether that's automating hours of repetitive tasks, increasing conversion rates, or building platforms that serve millions of users.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach Section -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Our Process</p>
        <h2 class="mb-6">How We Create <span class="plate-type">Digital Magic</span></h2>
        <p class="text-paper-mute">Our process keeps every project focused on a clear outcome, with strategic planning, real craft, and technical precision at each step.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {approach.map(step => (
          <div class="relative">
            <div class="card h-full">
              <div class="text-4xl font-bold plate-type mb-4">{step.step}</div>
              <h3 class="text-xl font-bold mb-3">{step.title}</h3>
              <p class="text-paper-mute">{step.description}</p>
            </div>
            {step.step !== "04" && (
              <div class="hidden lg:block absolute top-8 -right-4 w-8 h-0.5 bg-gradient-to-r from-ink-hot to-ink-cold"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Our Values Section -->
  <section class="section">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Our Core Values</p>
        <h2 class="mb-6">The Principles That <span class="plate-type">Drive</span> Us</h2>
        <p class="text-paper-mute">These fundamental values shape our culture, guide our decisions, and define how we approach every client relationship and project.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {values.map(value => (
          <div class="card">
            <h3 class="text-xl font-bold mb-3">{value.title}</h3>
            <p class="text-paper-mute">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What Sets Us Apart Section -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <p class="label-tech mb-4">Why Work With Us</p>
          <h2 class="mb-6">What Sets Creative Bandit <span class="plate-type">Apart</span></h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div class="space-y-8">
            <div>
              <h3 class="text-xl font-bold mb-3">AI Automation Expertise</h3>
              <p class="text-paper-mute">Production-tested experience with OpenAI GPT, Anthropic Claude, and Google Gemini APIs. Building intelligent systems that achieve 100% verification accuracy and reduce manual work by 90%.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3">Enterprise Background</h3>
              <p class="text-paper-mute">8+ years building applications for Fortune 500 companies (Eli Lilly, Salesforce) with expertise in design systems, accessibility testing, and well-architected systems.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3">Full-Stack Capability</h3>
              <p class="text-paper-mute">Complete solutions from React/Vue.js frontend to Node.js/Python backend, deployed on Vercel and AWS. No handoffs, no coordination overhead.</p>
            </div>
          </div>
          
          <div class="space-y-8">
            <div>
              <h3 class="text-xl font-bold mb-3">Proven Results</h3>
              <p class="text-paper-mute">85 top-ten rankings on a property we built and run, 40% page load improvement at EdReports, 97% AI verification accuracy at DowntownDry. Real metrics from real projects.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3">Healthcare Compliance</h3>
              <p class="text-paper-mute">HIPAA-compliant system development experience with secure patient data management, Medicare billing automation, and regulatory compliance.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-3">Async-First Collaboration</h3>
              <p class="text-paper-mute">Remote-first workflow with clear communication and flexible scheduling. Based in Indianapolis, serving clients nationwide with responses within 24 hours.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Team Section -->
  {team.length > 0 && (
    <section class="section">
      <div class="container mx-auto">
        <div class="max-w-3xl mb-16">
          <p class="label-tech mb-4">Who We Are</p>
          <h2 class="mb-6">Meet The <span class="plate-type">Team</span></h2>
          <p class="text-paper-mute">Two disciplines, one studio. Development and design working together from day one of every project.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-2xl mx-auto">
          {team.map(member => (
            <TeamMember 
              name={member.name} 
              position={member.position} 
              image={member.image} 
              bio={member.bio} 
            />
          ))}
        </div>
      </div>
    </section>
  )}
  
  <!-- CTA Section -->
  <section class="py-24 bg-base-200 relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="mb-6">Ready to Build Your <span class="plate-type">Next Thing</span>?</h2>
        <p class="text-paper-mute text-lg mb-8">Tell us what you're working on. We take on new builds and rescue jobs in about equal measure, and we'll help you ship either one.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary">Start Your Project</a>
          <a href="/work" class="btn-secondary">View Our Portfolio</a>
        </div>
      </div>
    </div>
    <!--
      This page's one scan-shape moment. Sits in the slot an empty decorative
      div was already holding, behind the CTA content at z-10. Hot ink here
      rather than the cold used on the homepage: this is the closing call to
      action, and hot is the accent every CTA on the site already carries.
    -->
    <div
      class="shape-scan shape-scan--01 shape-scan--hot hidden md:block -left-16 bottom-0 h-[70%] w-[45%] -rotate-3"
      aria-hidden="true"
    ></div>
  </section>
</Layout>
