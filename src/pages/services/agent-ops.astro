---
import Layout from '../../layouts/Layout.astro';
import { service } from '../../lib/schema';

const included = [
  {
    title: 'Security header audits + automated fixes',
    description: 'Scan for missing/misconfigured security headers (CSP, HSTS, X-Frame-Options, etc.) and automatically apply fixes where possible.'
  },
  {
    title: 'Plugin & core update monitoring',
    description: 'Track WordPress core, theme, and plugin versions across every client site and flag updates before they become a liability.'
  },
  {
    title: 'Uptime + broken link / mixed content scanning',
    description: 'Continuous uptime monitoring alongside scans for broken links and mixed-content (HTTP/HTTPS) issues that quietly hurt SEO and trust.'
  },
  {
    title: 'Weekly/monthly client-ready reports',
    description: 'Automated, white-label-ready reports you can hand straight to your clients. No manual compiling required.'
  }
];

// Pricing is handled per engagement during pilot onboarding. The tier table
// is deliberately omitted until rates are finalized with the first agencies.
const pricingTiers = [
  { name: 'Starter', sites: 'Up to 10 sites' },
  { name: 'Agency', sites: 'Up to 50 sites' },
  { name: 'Scale', sites: '50+ sites' }
];
---

<Layout
  title="Agent Ops: WordPress Security"
  description="Automated security, maintenance, and compliance monitoring for WordPress agencies and their clients. Currently onboarding pilot agencies."
  schema={[
    service({
      name: 'Agent Ops',
      description:
        'Automated security, maintenance, and compliance monitoring across a WordPress ' +
        'agency portfolio, with updates applied and verified on a schedule.',
      url: Astro.url.href,
      category: 'WordPress Maintenance',
    }),
  ]}
>
  <!-- Hero Section -->
  <section class="section pt-24 relative">
    <div class="container mx-auto">
      <div class="max-w-3xl">
        <p class="label-tech mb-6">New: Currently Onboarding Pilot Agencies</p>
        <h1 class="mb-6">Automated Security &amp; Maintenance Ops for <span class="plate-type">WordPress Agencies</span></h1>
        <p class="text-xl text-paper-mute mb-8">
          Agencies manage security, updates, and uptime across dozens of client sites by hand, a process that's slow and error-prone at scale. Agent Ops automates the monitoring and reporting so nothing falls through the cracks.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary">Book a Free Audit</a>
          <a href="/services" class="btn-secondary">Back to Services</a>
        </div>
      </div>
    </div>

    <div class="absolute top-0 right-0 w-full h-full -z-10">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-ink-hot/10 to-transparent opacity-30"></div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-16">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">What's Included</p>
        <h2 class="mb-6">Ops, <span class="plate-type">Automated</span></h2>
        <p class="text-paper-mute">A draft feature set, refined as pilot agencies come on board.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {included.map(item => (
          <div class="card">
            <h3 class="text-xl font-bold mb-3">{item.title}</h3>
            <p class="text-paper-mute">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Pricing</p>
        <h2 class="mb-6">Tiered by <span class="plate-type">Site Count</span></h2>
        <p class="text-paper-mute">Pilot pricing is finalized with each agency as we onboard. Tiering is by site count, not by ticket or by hour — you know what you pay every month regardless of how many issues come up.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {pricingTiers.map(tier => (
          <div class="card text-center">
            <h3 class="text-xl font-bold mb-2">{tier.name}</h3>
            <p class="text-paper-mute">{tier.sites}</p>
          </div>
        ))}
      </div>

      <div class="max-w-2xl mx-auto text-center border border-ink-hot/20 bg-base-100 p-8">
        <h3 class="text-xl font-bold mb-3">Pilot pricing, set with you</h3>
        <p class="text-paper-mute mb-6">We're onboarding a small group of agencies now and finalizing rates around real workflows. Book a free audit and we'll come back with a fixed monthly price for your site count — no hourly surprises, no per-ticket billing.</p>
        <a href="/contact" class="btn-primary">Book a Free Audit</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="mb-6">Managing Security Across <span class="plate-type">Client Sites</span> Manually?</h2>
        <p class="text-paper-mute text-lg mb-8">We're onboarding a small group of pilot agencies to shape Agent Ops around real workflows. Book a free audit to see where your client sites stand &mdash; or start smaller and scan one of them yourself, right now, without talking to anyone.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary">Book a Free Audit</a>
          <a href="/scan" class="btn-secondary">Scan One Site Free</a>
        </div>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-full h-full -z-10">
    </div>
  </section>
</Layout>
