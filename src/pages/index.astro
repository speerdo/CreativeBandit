---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/SpaceSceneHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AnimatedStats from '../components/AnimatedStats';
import Mascot from '../components/Mascot.astro';
import { localBusiness } from '../lib/schema';

const services = [
  {
    title: 'Web Development',
    description: 'Modern, performant web applications built with React, Vue.js, and TypeScript. Optimized for speed and SEO.',
    icon: 'web',
    link: '/services#web-development'
  },
  {
    title: 'AI Automation',
    description: 'Intelligent automation systems using OpenAI, Anthropic, and Google Gemini APIs to reduce manual work by 60-90% and improve accuracy.',
    icon: 'ai',
    link: '/services#ai-integration'
  },
  {
    title: 'WordPress Development',
    description: 'Custom WordPress builds, headless setups, and managed security and maintenance for agencies and business owners.',
    icon: 'support',
    link: '/services/wordpress'
  },
  {
    title: 'Design & Motion',
    description: 'Brand and UI design plus motion design: explainer animations, product motion, and social/marketing motion. Led by Katlyn.',
    icon: 'design',
    link: '/services#design'
  },
  {
    title: 'E-commerce Solutions',
    description: 'Custom online stores with automated affiliate marketing, SEO optimization, and payment processing, built on the same pipeline that runs our own properties.',
    icon: 'ecommerce',
    link: '/services#ecommerce'
  }
];

const projects = [
  {
    title: 'DowntownDry',
    category: 'AI Integration',
    image: '/images/downtowndry_desktop.webp',
    link: 'https://downtowndry.com',
    description: 'Google APIs plus Gemini verifying venue data at 97% accuracy, with 90%+ less manual review.'
  },
  {
    title: 'Yield to Freedom',
    category: 'Full-Stack Development / Fintech',
    image: '/images/yieldtofreedom_desktop.webp',
    link: 'https://yieldtofreedom.com',
    description: '200+ income ETFs graded on a transparent A-to-D system, refreshed daily by a custom ingestion engine.'
  },
  {
    title: 'RecycleOldTech.com',
    category: 'E-commerce / SEO',
    image: '/images/recycleoldtech_desktop.webp',
    link: 'https://recycleoldtech.com',
    description: 'US e-waste recycling directory whose automated SEO pipeline took it from zero to 85 top-ten rankings in fourteen months.'
  },
  {
    title: 'EdReports Platform Migration',
    category: 'Full-Stack Development',
    image: '/images/edreports_desktop.webp',
    link: 'https://edreports.org/reports',
    description: 'Legacy Java and Vue 3 moved to Nuxt.js: 40% faster page loads, zero downtime during the migration.'
  }
];
---

<Layout
  title="The Build Team For WordPress Agencies"
  schema={[localBusiness(Astro.url.href)]}
  description="The white-label build team behind WordPress agencies. We ship the AI work your clients are asking for, under your name, plus design and motion overflow."
  keywords="white label AI development, WordPress agency partner, subcontract AI development, white label web development, AI readiness scan, agency overflow design, AI automation consultant, full-stack developer, WordPress development, headless WordPress, Indianapolis developer"
>
  <Hero />

  <!-- The Problem Section -->
  <section class="section">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">The position you're in</p>
        <h2 class="mb-6">Every Agency Is Having The Same <span class="plate-type">Three Conversations</span> Right Now</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="text-xl font-bold mb-3">The client asks first</h3>
          <p class="text-paper-mute">They've read something, or a competitor shipped a chat layer. They want to know what you're doing about it. Saying "we're evaluating options" works exactly once.</p>
        </div>

        <div class="card">
          <h3 class="text-xl font-bold mb-3">Hiring for it doesn't pencil</h3>
          <p class="text-paper-mute">An engineer who can actually ship this is expensive and hard to keep busy. You need one three times a quarter, not five days a week.</p>
        </div>

        <div class="card">
          <h3 class="text-xl font-bold mb-3">The cheap tools embarrass you</h3>
          <p class="text-paper-mute">A bolt-on chat widget that hallucinates pricing is worse than nothing. It goes out under your name, and so does the apology.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <!-- Same header-row treatment as Real Results below: mascot fills the
           empty right, hidden below lg where the column collapses. -->
      <div class="mb-16 flex items-end justify-between gap-10">
        <div class="max-w-3xl">
          <p class="label-tech mb-4">What we build</p>
          <h2 class="mb-6">Two Things Agencies <span class="plate-type">Subcontract Badly</span>. We Do Both Properly.</h2>
          <p class="text-paper-mute">Everything ships white-labeled. Your client never has to know we exist, and we're fine with that. Engineering and creative under one roof, working direct with businesses too.</p>
        </div>
        <Mascot pose="rocket" class="hidden w-[260px] shrink-0 lg:block xl:w-[300px]" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            link={service.link}
          />
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/services" class="btn-secondary">Explore All Services</a>
      </div>
    </div>
  </section>

  <!-- The Scan Section -->
  <section class="section">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-12">
        <p class="label-tech mb-4">Start here</p>
        <h2 class="mb-6">Point Us At One Client Site. We'll Tell You <span class="plate-type">What's Actually Possible</span>.</h2>
        <p class="text-paper-mute text-lg mb-4">Most AI conversations start with a pitch deck. This one starts with findings about a site you already manage.</p>
        <p class="text-paper-mute">WordPress is where we live, but the scan is not WordPress-only. Point it at a Shopify store, a Squarespace build, a Webflow site, or something bespoke, and it detects the platform and tells you what to fix there specifically.</p>
      </div>

      <div class="max-w-3xl">
        <div class="flex gap-6 border-b border-paper/15 py-6">
          <span class="font-mono text-sm text-ink-acid pt-1">01</span>
          <div>
            <h3 class="text-xl font-bold mb-2">Give us a URL</h3>
            <p class="text-paper-mute">One client site. No account, no discovery call, no form that asks for your budget range before it tells you anything.</p>
          </div>
        </div>

        <div class="flex gap-6 border-b border-paper/15 py-6">
          <span class="font-mono text-sm text-ink-acid pt-1">02</span>
          <div>
            <h3 class="text-xl font-bold mb-2">We scan and report</h3>
            <p class="text-paper-mute">Whether AI crawlers can reach the site at all, what its markup actually tells them about the business, whether the content survives without JavaScript, and the metadata, image and delivery problems we turn up on the way. Specific findings, not a grade.</p>
          </div>
        </div>

        <div class="flex gap-6 py-6">
          <span class="font-mono text-sm text-ink-acid pt-1">03</span>
          <div>
            <h3 class="text-xl font-bold mb-2">You decide what to do with it</h3>
            <p class="text-paper-mute">Take the report to your client and win the work yourself. Or hand the build to us and put your name on it. Both outcomes are fine. The report is yours either way.</p>
          </div>
        </div>
      </div>

      <div class="mt-10">
        <a href="/scan" class="btn-primary">Scan a Client Site</a>
      </div>
    </div>
  </section>

  <!-- About Us Section -->
  <section class="section relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="label-tech mb-6">Why us</p>
          <h2 class="mb-6">We <span class="plate-type">Operate</span> What We Sell</h2>
          <p class="text-paper-mute mb-6">
            We run our own properties, built and maintained by the same two people who'd be doing your work. We find the problems in our own sites before we go looking in yours. Adam brings 8+ years of full-stack and AI automation experience; Katlyn leads design and motion.
          </p>
          <p class="text-paper-mute mb-8">
            And we've shipped where being wrong has consequences: HIPAA-compliant automation for Medicare billing, healthcare technology at Eli Lilly, platforms at Salesforce serving thousands of users. The standards there are not the standards of a weekend chatbot build.
          </p>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <h4 class="font-bold text-lg mb-2 text-ink-acid">Engineering</h4>
              <p class="text-paper-mute text-sm">Not a chat bubble trained on a sitemap. Agents wired into the systems a business actually runs on, plus the monitoring to keep them from drifting.</p>
            </div>
            <div>
              <h4 class="font-bold text-lg mb-2 text-ink-hot">Creative</h4>
              <p class="text-paper-mute text-sm">The overflow work currently going to a freelancer you have to manage. Same team, same standards, already briefed on the build.</p>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="p-8 border border-ink-hot/20 bg-base-100">
            <h3 class="text-xl font-bold mb-6">How This Works Commercially</h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-paper-mute">You're reselling this. We price with that in mind, so there's room for your margin</span>
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-ink-hot mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-paper-mute">We don't approach your clients directly, ever. Everything ships under your name</span>
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-ink-hot mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-paper-mute">Fixed scope, fixed price, agreed before anything starts. No hourly surprises landing in the middle of your client's project</span>
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-ink-cold mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-paper-mute">Monthly retained capacity across engineering and creative, priced by the number of sites you run, not by ticket</span>
              </li>
              <li class="flex items-start">
                <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
                <span class="text-paper-mute">Two people, no handoffs. You talk to the engineer and the designer, with no account manager in between</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section class="section relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <!-- Mascot fills the empty right of the header row. Hidden below lg,
           where the column collapses and there is no space to fill. -->
      <div class="mb-16 flex items-end justify-between gap-10">
        <div class="max-w-3xl">
          <p class="label-tech mb-4">Real Results</p>
          <h2 class="mb-6">Measurable <span class="plate-type">Business Impact</span></h2>
          <p class="text-paper-mute">Concrete outcomes from real projects. Every metric represents actual production results, not projections.</p>
        </div>
        <Mascot pose="pistols" class="hidden w-[124px] shrink-0 lg:block xl:w-[148px]" />
      </div>

      <div class="mb-16">
        <AnimatedStats client:only="react" />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="p-8 border border-ink-acid/20 bg-gradient-to-br from-base-100 to-base-200">
          <h3 class="text-xl font-bold mb-6 text-ink-acid">AI & Automation Wins</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">DowntownDry: 97% accuracy venue verification using Gemini AI + Google APIs</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">RecycleOldTech: 10,000+ monthly visitors from an automated content pipeline</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">IndiAide: HIPAA-compliant automation for Medicare RTM billing compliance</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-acid mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">AI-assisted development workflows reducing debugging time by 20%</span>
            </li>
          </ul>
        </div>

        <div class="p-8 border border-ink-cold/20 bg-gradient-to-br from-base-100 to-base-200">
          <h3 class="text-xl font-bold mb-6 text-ink-cold-lift">Enterprise Achievements</h3>
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-cold mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">Eli Lilly: Led Next.js migration and React design system transition</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-cold mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">Salesforce: API integration layer reducing manual data entry by 60%</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-cold mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">EdReports: 30% increase in developer productivity post-migration</span>
            </li>
            <li class="flex items-start">
              <span class="w-2 h-2 bg-ink-cold mt-2 mr-3 flex-shrink-0"></span>
              <span class="text-paper-mute">Design system adoption across 15+ engineers on pharmaceutical applications</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/*
    Still out. The email side is solved now - /api/subscribe writes to a Resend
    Audience and the footer carries a working signup - but this section offered
    an "AI Automation Readiness Checklist" PDF, and that asset has never been
    written. The homepage's job is the scan; a second offer here would compete
    with it anyway. Restore only when the PDF exists.
  */}

  <!-- Projects Section -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <div class="mb-16 flex items-end justify-between gap-10">
        <div class="max-w-3xl">
          <p class="label-tech mb-4">Recent work</p>
          <h2 class="mb-6">Builds, And What They <span class="plate-type">Actually Changed</span></h2>
          <p class="text-paper-mute">Production applications, several of them our own properties. Numbers beat adjectives, so these are the measurable outcomes rather than the deliverable lists.</p>
        </div>
        <Mascot pose="batting" class="hidden w-[168px] shrink-0 lg:block xl:w-[196px]" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
        {projects.map(project => (
          <ProjectCard
            title={project.title}
            category={project.category}
            image={project.image}
            link={project.link}
            description={project.description}
          />
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/work" class="btn-secondary">See More Projects</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <!-- The page's second and last ink field. Three faint blur blobs used to
         sit here as ambient filler; one saturated field earns the moment. -->
    <div class="field field-hot -z-10 -bottom-64 -right-32 h-[38rem] w-[38rem]"></div>
    <div class="container mx-auto relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="label-tech mb-6">Run a scan</p>
          <h2 class="mb-6">Find Out What One Client Site Is <span class="plate-type">Sitting On</span></h2>
          <p class="text-paper-mute text-lg mb-8">
            The scan is free, it usually takes a few seconds, and the report is useful whether or not you ever hire us.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            <div class="flex items-center">
              <span class="w-3 h-3 bg-ink-acid mr-3"></span>
              <span class="text-paper-mute">Free, no obligation</span>
            </div>
            <div class="flex items-center">
              <span class="w-3 h-3 bg-ink-hot mr-3"></span>
              <span class="text-paper-mute">Full findings, yours to keep</span>
            </div>
            <div class="flex items-center">
              <span class="w-3 h-3 bg-ink-hot mr-3"></span>
              <span class="text-paper-mute"><a href="/services#pricing" class="hover:text-ink-acid transition-colors duration-300">Priced so you can mark it up</a></span>
            </div>
            <div class="flex items-center">
              <span class="w-3 h-3 bg-ink-cold mr-3"></span>
              <span class="text-paper-mute">White-labeled, start to finish</span>
            </div>
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="/scan" class="btn-primary">Run a Free Scan</a>
            <a href="/contact" class="btn-secondary">Book 20 Minutes Instead</a>
          </div>
        </div>

        <div class="p-8 border border-ink-hot/20 bg-base-100">
          <h3 class="text-xl font-bold mb-6">What You Get With Creative Bandit</h3>
          <div class="space-y-6">
            <div class="border-l-4 border-ink-acid pl-4">
              <h4 class="font-bold text-lg mb-2">Enterprise Experience</h4>
              <p class="text-paper-mute text-sm">8+ years building production applications for Fortune 500 companies including Eli Lilly and Salesforce.</p>
            </div>

            <div class="border-l-4 border-ink-hot pl-4">
              <h4 class="font-bold text-lg mb-2">AI Automation Expertise</h4>
              <p class="text-paper-mute text-sm">Proven results with OpenAI, Anthropic, and Google Gemini APIs. 97% accuracy verification, 90% time savings.</p>
            </div>

            <div class="border-l-4 border-ink-hot pl-4">
              <h4 class="font-bold text-lg mb-2">Full-Stack Capability</h4>
              <p class="text-paper-mute text-sm">React, Vue.js, TypeScript, Node.js, Python. Complete solutions from frontend to backend to deployment.</p>
            </div>

            <div class="border-l-4 border-ink-acid pl-4">
              <h4 class="font-bold text-lg mb-2">Design & Motion In-House</h4>
              <p class="text-paper-mute text-sm">Brand, UI, and motion design led by Katlyn. The overflow work you'd otherwise hand to a freelancer you have to manage.</p>
            </div>

            <div class="border-l-4 border-ink-cold pl-4">
              <h4 class="font-bold text-lg mb-2">Your Name On All Of It</h4>
              <p class="text-paper-mute text-sm">White-labeled by default, async-first, no account manager in between. Based in Indianapolis, serving agencies nationwide.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
