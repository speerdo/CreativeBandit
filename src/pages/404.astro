---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found"
  description="That page doesn't exist. Try one of these instead."
>
  <section class="section pt-32 relative">
    <div class="container mx-auto">
      <div class="max-w-3xl">
        <p class="label-tech mb-6">404</p>
        <h1 class="mb-6">This Page <span class="plate-type">Isn't Here</span></h1>
        <p class="text-xl text-paper-mute mb-10">
          The URL may be stale, mistyped, or never existed. These are the pages that do.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
          <a href="/" class="card hover:border-ink-acid/40 transition-colors duration-200">
            <h3 class="text-lg font-bold mb-1">Home</h3>
            <p class="text-paper-mute text-sm">What the studio does and who it's for.</p>
          </a>
          <a href="/work" class="card hover:border-ink-acid/40 transition-colors duration-200">
            <h3 class="text-lg font-bold mb-1">Our Work</h3>
            <p class="text-paper-mute text-sm">Production builds and the measurable result for each.</p>
          </a>
          <a href="/services" class="card hover:border-ink-acid/40 transition-colors duration-200">
            <h3 class="text-lg font-bold mb-1">Services</h3>
            <p class="text-paper-mute text-sm">What we build, from AI integration to WordPress care.</p>
          </a>
          <a href="/scan" class="card hover:border-ink-acid/40 transition-colors duration-200">
            <h3 class="text-lg font-bold mb-1">Free AI Scan</h3>
            <p class="text-paper-mute text-sm">Point us at a site and get the findings back in seconds.</p>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>