        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class={`${index % 2 === 0 ? 'order-2 lg:order-1' : 'order-2 lg:order-2'}`}>
            <p class="label-tech mb-4">{service.id === 'web-development' ? 'Expert Web Development' :
                 service.id === 'design' ? 'Design & Motion, Led by Katlyn' :
                 service.id === 'ai-integration' ? 'Advanced AI Solutions' : 
                 service.id === 'app-development' ? 'Mobile App Excellence' : 
                 service.id === 'ecommerce' ? 'E-commerce Expertise' : 
                 'Strategic Guidance'}</p>
            <h2 class="mb-6">{service.title}</h2>
            <p class="mb-6 text-paper-mute">
              {service.id === 'web-development' ? 
