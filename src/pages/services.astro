---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { service } from '../lib/schema';

const pricingTiers = [
  {
    name: 'Discovery / Audit',
    price: '$500-750',
    description: 'A focused audit of your current site, systems, or manual workflows, with a concrete plan for what to automate or build next.'
  },
  {
    name: 'Automation Project',
    price: '$2,500-5,000',
    description: 'A scoped automation build: a workflow, integration, or AI-powered pipeline that eliminates a specific manual bottleneck.'
  },
  {
    name: 'Full Application',
    price: '$10k+',
    description: 'End-to-end design and development of a full web application or platform, from architecture through launch.'
  }
];

const services = [
  {
    title: 'AI Automation',
    description: 'Intelligent automation systems using OpenAI, Anthropic, and Google Gemini APIs to reduce manual work by 60-90%.',
    icon: 'ai',
    link: '#ai-integration',
    id: 'ai-integration',
    stack: ['OpenAI', 'Anthropic', 'Gemini', 'Python', 'Node.js', 'Postgres']
  },
  {
    title: 'Web Development',
    description: 'Modern, performant web applications built with React, Vue.js, and TypeScript. Optimized for speed and SEO.',
    icon: 'web',
    link: '#web-development',
    id: 'web-development',
    stack: ['React', 'Vue.js', 'TypeScript', 'Next.js', 'Nuxt', 'Astro']
  },
  {
    title: 'E-commerce Solutions',
    description: 'Custom online stores with automated affiliate marketing, SEO optimization, and payment processing.',
    icon: 'ecommerce',
    link: '#ecommerce',
    id: 'ecommerce',
    stack: ['Shopify', 'WooCommerce', 'Stripe', 'Supabase', 'Vercel']
  },
  {
    title: 'Design & Motion',
    description: 'Brand and UI design plus motion design: explainer animations, product motion, and social/marketing motion. Led by Katlyn.',
    icon: 'design',
    link: '#design',
    id: 'design',
    stack: ['Figma', 'After Effects', 'Illustrator', 'Lottie', 'Rive']
  },
  {
    title: 'Healthcare Technology',
    description: 'HIPAA-compliant systems for healthcare providers. Secure patient data management and compliance automation.',
    icon: 'app',
    link: '#healthcare',
    id: 'healthcare',
    stack: ['HIPAA controls', 'AWS', 'Postgres', 'Audit logging', 'SSO']
  },
  {
    title: 'Workflow Automation',
    description: 'Custom automation pipelines that eliminate manual tasks, reduce errors, and scale your operations.',
    icon: 'web',
    link: '#automation',
    id: 'automation',
    stack: ['Node.js', 'Python', 'Postgres', 'Webhooks', 'Cron', 'Queues']
  },
  {
    title: 'Agent Ops',
    description: 'Automated security, maintenance, and compliance monitoring for WordPress agencies and their clients. Currently onboarding pilot agencies.',
    icon: 'support',
    link: '/services/agent-ops',
    id: 'agent-ops',
    stack: ['WP-CLI', 'WP Engine', 'Uptime monitoring', 'Automated backups']
  },
  {
    title: 'WordPress Development',
    description: 'Custom WordPress builds, headless setups, theme and plugin work, and managed care for agencies and business owners.',
    icon: 'support',
    link: '/services/wordpress',
    id: 'wordpress',
    stack: ['WordPress', 'WP-CLI', 'ACF', 'Headless WP', 'WP Engine']
  }
];

// Agent Ops and WordPress each have their own dedicated page, so they're excluded from the on-page anchor sections below.
const detailedServices = services.filter(service => !['agent-ops', 'wordpress'].includes(service.id));
/*
 * One Service node per offering, built from the same list the page renders so
 * the two cannot drift. Service requires `provider` as well as `name` — see
 * lib/schema.ts.
 */
const serviceSchema = services.map((s) =>
  service({
    name: s.title,
    description: s.description,
    url: `${Astro.url.origin}/services#${s.id}`,
    category: s.title,
  })
);
---

<Layout
  title="Services"
  description="AI automation, full-stack web development, WordPress, design and motion, e-commerce, and healthcare technology from a two-person studio."
  schema={serviceSchema}
>
  <!-- Hero Section -->
  <section class="section pt-24 relative">
    <div class="container mx-auto">
      <div class="max-w-3xl">
        <p class="label-tech mb-6">What We Do</p>
        <h1 class="mb-6">Services That <span class="plate-type">Deliver</span> Results</h1>
        <p class="text-xl text-paper-mute mb-8">
          AI automation, full-stack development, WordPress, and design &amp; motion under one roof, built to deliver measurable business impact.
        </p>
      </div>
    </div>
    
    <div class="absolute top-0 right-0 w-full h-full -z-10">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-ink-hot/10 to-transparent opacity-30"></div>
    </div>
  </section>
  
  <!-- Services Overview -->
  <section class="py-16">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <ServiceCard 
            title={service.title}
            description={service.description}
            icon={service.icon}
            link={service.link}
          />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Service Details -->
  {detailedServices.map((service, index) => (
    <section id={service.id} class="py-24 relative even:bg-base-200">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class={`${index % 2 === 0 ? 'order-2 lg:order-1' : 'order-2 lg:order-2'}`}>
            <p class="label-tech mb-4">{service.id === 'web-development' ? 'Expert Web Development' :
                 service.id === 'design' ? 'Design & Motion, Led by Katlyn' :
                 service.id === 'ai-integration' ? 'Advanced AI Solutions' : 
                 service.id === 'app-development' ? 'Mobile App Excellence' : 
                 service.id === 'ecommerce' ? 'E-commerce Expertise' : 
                 'Strategic Guidance'}</p>
            <h2 class="mb-6">{service.title}</h2>
            <p class="mb-6 text-paper-mute">
              {service.id === 'web-development' ? 
                'We build fast, well-structured websites and web applications that work well across every device. Development pairs technical know-how with practical problem-solving so the result looks good and runs cleanly.' :
              service.id === 'design' ?
                'Great design is more than aesthetics: it&apos;s about building intuitive experiences and motion that helps a brand move. Katlyn leads brand, UI, and motion design, from static interfaces to explainer animations and social/marketing motion that brings products to life.' :
              service.id === 'ai-integration' ? 
                'We add AI to your digital products in ways that actually help: automating processes, improving functionality, and giving users more relevant experiences. We focus on practical AI applications that produce real business value.' :
