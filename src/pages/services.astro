                  </li>
                  <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink-hot mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Business process optimization</span>
                  </li>
                  <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink-hot mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Performance analytics and reporting</span>
                  </li>
                </>
              )}
            </ul>
            
            <a href="/contact" class="btn-primary">Discuss Your Project</a>
          </div>
          
          <div class={`${index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1 lg:order-1'}`}>
            {service.id === 'design' ? (
              <DuoPanel />
            ) : service.id === 'ecommerce' ? (
              <ShopScene />
            ) : service.id === 'web-development' ? (
              <SwatPanel />
            ) : service.id === 'ai-integration' ? (
              /*
               * The rocket cat, the same craft and hyperdrive treatment the
               * homepage uses. No shadow-xl frame around it: the mascot is a
               * cut-out with its own streak field, so a drop-shadowed panel
               * would put a rectangle where the artwork deliberately has none.
               *
               * The generous vertical padding is load-bearing. The hull is
               * rotated 20deg by .cb-mascot--rocket, and the exhaust plume
               * overflows the viewBox on purpose, so the artwork needs room
               * above and below its own box or the plume gets cropped by the
               * next row.
               */
              <div class="flex items-center justify-center py-10">
                <Mascot pose="rocket" class="w-full max-w-[520px]" />
              </div>
            ) : (
              <img
                src={STOCK_IMAGE[service.id] ?? STOCK_FALLBACK}
                alt={service.title}
                class="w-full h-auto shadow-xl"
              />
            )}
          </div>
        </div>
      </div>
    </section>
  ))}
  
  <!--
    Target range. Sits between the service detail and pricing: a breather at
    the point in the page where someone has just read six sections of prose.
  -->
  <section class="section">
    <div class="container mx-auto">
      <div class="mx-auto max-w-3xl">
        <UfoShooter />
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="section">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Transparent Pricing</p>
        <h2 class="mb-6">What Projects <span class="plate-type">Typically Cost</span></h2>
        <p class="text-paper-mute">Every project is scoped individually. These ranges give you a starting point before we talk specifics.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pricingTiers.map(tier => (
          <div class="card text-center">
            <h3 class="text-xl font-bold mb-2">{tier.name}</h3>
            <p class="text-2xl font-bold plate-type mb-4">{tier.price}</p>
            <p class="text-paper-mute">{tier.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-base-200 relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="mb-6">Ready to <span class="plate-type">Get Started</span>?</h2>
        <p class="text-paper-mute text-lg mb-8">Tell us about your project and we'll walk through how these services fit your goals.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary">Get In Touch</a>
          <a href="/work" class="btn-secondary">View Our Work</a>
        </div>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-full h-full -z-10">
    </div>
  </section>
</Layout>
