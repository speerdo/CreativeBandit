                  <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink-hot mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Business process optimization</span>
                  </li>
                  <li class="flex items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-ink-hot mr-2 mt-1 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Performance analytics and reporting</span>
                  </li>
                </>
              )}
            </ul>
            
            <a href="/contact" class="btn-primary">Discuss Your Project</a>
          </div>
          
          {/*
            A typographic spec plate, not a photograph. Six generic Pexels
            stock shots used to sit here - hotlinked, unsized, and exactly the
            "creative team collaborating" filler that ProjectCard.astro's own
            comment explains we stopped using once the work was real.

            Replacing them with the stack is a straight upgrade on three
            counts: it is information rather than decoration, an agency
            evaluating a subcontractor genuinely wants to know what we build
            in, and it carries the house style through crop marks, mono labels
            and ink accents instead of through a recoloured photo. It also
            costs no bytes and no third-party request.
          */}
          <div class={`${index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1 lg:order-1'}`}>
            <div class="crop-marks border border-paper/15 bg-base-100 p-8 lg:p-10">
              <div class="mb-8 flex items-start justify-between gap-6">
                <div>
                  <p class="label-tech mb-3">What we build it in</p>
                  <p class="font-display text-2xl font-extrabold uppercase leading-none text-paper" style="font-stretch: 125%;">
                    {service.title}
                  </p>
                </div>
                {/* Decorative: the heading beside it already names the service. */}
                <span
                  class="h-2 w-16 shrink-0 self-center"
                  class:list={[index % 3 === 0 ? 'bg-ink-hot' : index % 3 === 1 ? 'bg-ink-acid' : 'bg-ink-cold']}
                  aria-hidden="true"
                ></span>
              </div>

              <ul class="flex flex-wrap gap-2">
                {service.stack.map((tool) => (
                  <li class="border border-paper/20 px-3 py-2 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-paper-mute">
                    {tool}
                  </li>
                ))}
              </ul>

              <p class="mt-8 border-t border-paper/15 pt-6 text-sm text-paper-mute">
                Not an exhaustive list. We pick the stack around the problem and the team who has to maintain it after we hand it over.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}
  
  <!-- Pricing Section -->
  <section id="pricing" class="section">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Transparent Pricing</p>
        <h2 class="mb-6">What Projects <span class="plate-type">Typically Cost</span></h2>
        <p class="text-paper-mute">Every project is scoped individually. These ranges give you a starting point before we talk specifics.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pricingTiers.map(tier => (
          <div class="card text-center">
            <h3 class="text-xl font-bold mb-2">{tier.name}</h3>
            <p class="text-2xl font-bold plate-type mb-4">{tier.price}</p>
            <p class="text-paper-mute">{tier.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-base-200 relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="mb-6">Ready to <span class="plate-type">Get Started</span>?</h2>
        <p class="text-paper-mute text-lg mb-8">Tell us about your project and we'll walk through how these services fit your goals. Or skip the conversation entirely for now and run the free scan against a site you already manage.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary">Get In Touch</a>
          <a href="/scan" class="btn-secondary">Run a Free Scan</a>
          <a href="/work" class="btn-secondary">View Our Work</a>
        </div>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-full h-full -z-10">
    </div>
  </section>
</Layout>
