---
import Layout from '../layouts/Layout.astro';
import { service } from '../lib/schema';

const scanService = service({
  name: 'AI Readiness Scan',
  description:
    'A free scan reporting whether AI assistants can reach and read a site, covering ' +
    'robots.txt, CDN-level crawler blocks, structured data, metadata and delivery.',
  url: Astro.url.href,
  category: 'AI Readiness Audit',
});
---

<Layout
  title="Free AI Readiness Scan"
  description="Point us at one client site and we'll tell you what AI assistants can and can't do with it, plus the schema and metadata problems we find. Free, no account."
  schema={[scanService]}
  keywords="AI readiness scan, GPTBot blocked, ClaudeBot robots.txt, AI crawler blocking, structured data audit, schema markup checker, duplicate title checker, image alt text audit, sitemap checker, WordPress AI audit, Shopify AI audit, Squarespace AI audit, Webflow AI audit, llms.txt"
>
  <section class="section pt-32">
    <div class="container mx-auto">
      <div class="max-w-3xl">
        <p class="label-tech mb-4">Free scan</p>
        <h1 class="mb-6">What Can AI Assistants <span class="plate-type">Actually See</span> On This Site?</h1>
        <p class="text-paper-mute text-lg mb-4">
          One client site. No account, no discovery call, no form that asks for your budget range before it tells you anything.
        </p>
        <p class="text-paper-mute mb-4">
          The headline is AI visibility: whether GPTBot, ClaudeBot, PerplexityBot and Google-Extended can reach the site at all, and whether there is anything structured for them to read when they get there. But the same pass turns up the ordinary problems on the way: missing descriptions, templated titles, images with no alt text, a sitemap that does not exist, content that only appears after JavaScript runs, redirects that never resolve. Those are in the report too, and they are usually the quickest things to bill for.
        </p>
        <p class="text-paper-mute mb-10">
          Built for WordPress, but it is not a WordPress tool. Point it at Shopify, Squarespace, Webflow, Wix, Drupal, Ghost, or something hand-rolled and it works out the platform, then tailors what it tells you to fix.
        </p>

        <form id="scanForm" class="crop-marks border border-paper/15 bg-base-100 p-8">
          <label for="scanUrl" class="mb-2 block font-mono text-[0.7rem] uppercase tracking-[0.14em] text-paper-mute">
            Site URL <span class="text-ink-hot">*</span>
          </label>
          <input
            type="text"
            id="scanUrl"
            name="url"
            required
            placeholder="clientsite.com"
            autocomplete="url"
            class="w-full border border-paper/20 bg-base-200 px-4 py-3 text-paper transition-colors duration-200 focus:border-ink-acid focus:outline-none focus:ring-1 focus:ring-ink-acid"
          />

          <label class="mt-6 flex items-start gap-3">
            <input
              type="checkbox"
              id="scanAttest"
              required
              class="mt-1 h-4 w-4 flex-shrink-0 accent-[#E8451F]"
            />
            <span class="text-sm text-paper-mute">
              I manage this site, or I have permission to scan it.
            </span>
          </label>

          <button type="submit" id="scanSubmit" class="btn-primary mt-8 w-full py-4 text-lg">
            Run the Scan
          </button>

          <p class="mt-3 text-center font-mono text-[0.65rem] uppercase tracking-[0.12em] text-paper-mute/70">
            No call required. Usually a few seconds; up to a minute on a large site.
          </p>
        </form>

        <!-- Status line, swapped for results once the scan returns. -->
        <p id="scanStatus" class="mt-6 font-mono text-sm text-ink-acid" hidden></p>
        <p id="scanError" class="mt-6 font-mono text-sm text-ink-hot" role="alert" hidden></p>
      </div>

      <!-- Results. Structure mirrors the card in docs/creative-bandit-homepage.html. -->
      <div id="scanResults" class="mt-12 max-w-3xl" hidden>
        <div class="flex items-center justify-between border border-paper/15 bg-base-200 px-5 py-3">
          <span class="font-mono text-xs text-paper-mute">
            <span id="scanDomain"></span>
          </span>
          <span class="font-mono text-xs text-paper-mute">AI readiness scan</span>
        </div>

        <div id="scanFindings" class="border-x border-b border-paper/15"></div>

        <div class="border-x border-b border-paper/15 bg-base-200 px-5 py-3 font-mono text-xs text-paper-mute">
          <span id="scanFooter"></span>
        </div>

        <!--
          Capture sits AFTER the findings, never before them. The scan stays
          ungated - this page promises that in as many words - so the ask is
          for a forwardable copy of something already on screen, not a toll
          to see it. See docs/creative-bandit-launch-readiness.md §9.1.
        -->
        <form id="reportForm" class="mt-10 crop-marks border border-paper/15 bg-base-100 p-8">
          <p class="label-tech mb-3">Take it with you</p>
          <h2 class="mb-3 text-xl font-bold">Email yourself this report</h2>
          <p class="text-paper-mute mb-6 text-sm">
            The full findings, in a format you can forward to your client. One email, no list, no follow-up sequence.
          </p>

          <div class="flex flex-col gap-4 sm:flex-row">
            <label for="reportEmail" class="sr-only">Your email address</label>
            <input
              type="email"
              id="reportEmail"
              name="email"
              required
              placeholder="you@agency.com"
              autocomplete="email"
              class="w-full flex-1 border border-paper/20 bg-base-200 px-4 py-3 text-paper transition-colors duration-200 focus:border-ink-acid focus:outline-none focus:ring-1 focus:ring-ink-acid"
            />
            <button type="submit" id="reportSubmit" class="btn-primary shrink-0">Send It</button>
          </div>

          <p id="reportStatus" class="mt-4 font-mono text-sm" role="status" aria-live="polite"></p>
        </form>

        <div class="mt-10">
          <p class="text-paper-mute mb-6">
            Take these findings to your client and win the work yourself, or hand the build to us and put your name on it. Both outcomes are fine.
          </p>
          <a href="/contact" class="btn-primary">Talk to Us About the Build</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector('#scanForm') as HTMLFormElement | null;
  const urlInput = document.querySelector('#scanUrl') as HTMLInputElement | null;
  const attest = document.querySelector('#scanAttest') as HTMLInputElement | null;
  const submit = document.querySelector('#scanSubmit') as HTMLButtonElement | null;
  const status = document.querySelector('#scanStatus') as HTMLElement | null;
  const errorEl = document.querySelector('#scanError') as HTMLElement | null;
  const results = document.querySelector('#scanResults') as HTMLElement | null;
  const findingsEl = document.querySelector('#scanFindings') as HTMLElement | null;
  const domainEl = document.querySelector('#scanDomain') as HTMLElement | null;
  const footerEl = document.querySelector('#scanFooter') as HTMLElement | null;
  const reportForm = document.querySelector('#reportForm') as HTMLFormElement | null;
  const reportEmail = document.querySelector('#reportEmail') as HTMLInputElement | null;
  const reportSubmit = document.querySelector('#reportSubmit') as HTMLButtonElement | null;
  const reportStatus = document.querySelector('#reportStatus') as HTMLElement | null;

  /** The scan currently on screen, including its signature. */
  let lastResult: unknown = null;

  interface Finding {
    id: string;
    tag: 'gap' | 'opportunity' | 'good';
    title: string;
    detail: string;
    evidence?: { quote?: string; source?: string };
    remediation: string;
  }

  // Tag colours come from the existing ink palette rather than new tokens.
  const TAG_CLASS: Record<Finding['tag'], string> = {
    gap: 'border-ink-hot text-ink-hot',
    opportunity: 'border-ink-cold-lift text-ink-cold-lift',
    good: 'border-ink-acid text-ink-acid',
  };

  const TAG_LABEL: Record<Finding['tag'], string> = {
    gap: 'Gap',
    opportunity: 'Opportunity',
    good: 'Good',
  };

  function show(el: HTMLElement | null, visible: boolean) {
    if (el) el.hidden = !visible;
  }

  function renderFinding(finding: Finding): HTMLElement {
    const row = document.createElement('div');
    row.className = 'flex gap-4 border-b border-paper/10 px-5 py-4 last:border-b-0';

    const tag = document.createElement('span');
    tag.className = `h-fit shrink-0 border px-2 py-1 font-mono text-[0.6rem] uppercase tracking-[0.1em] ${TAG_CLASS[finding.tag]}`;
    tag.textContent = TAG_LABEL[finding.tag];

    const body = document.createElement('div');

    const title = document.createElement('strong');
    title.className = 'block text-paper';
    title.textContent = finding.title;
    body.append(title);

    const detail = document.createElement('span');
    detail.className = 'mt-1 block text-sm text-paper-mute';
    detail.textContent = finding.detail;
    body.append(detail);

    // Never assert without showing the receipt.
    if (finding.evidence?.quote) {
      const quote = document.createElement('code');
      quote.className = 'mt-2 block bg-base-200 px-2 py-1 font-mono text-xs text-paper-dim';
      quote.textContent = finding.evidence.quote;
      body.append(quote);
    }

    const fix = document.createElement('span');
    fix.className = 'mt-2 block text-sm text-paper-mute/80';
    fix.textContent = `Fix: ${finding.remediation}`;
    body.append(fix);

    row.append(tag, body);
    return row;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!urlInput || !attest || !submit) return;

    show(errorEl, false);
    show(results, false);
    show(status, true);
    if (status) status.textContent = 'Probing crawlers, fetching sitemap, and sampling pages...';
    submit.disabled = true;
    submit.textContent = 'Scanning...';

    try {
      const response = await fetch('/api/scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: urlInput.value, attested: attest.checked }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error ?? 'The scan could not complete.');
      }

      show(status, false);

      if (domainEl) domainEl.textContent = new URL(data.url).hostname;
      if (findingsEl) {
        findingsEl.replaceChildren(...data.findings.map(renderFinding));
      }
      if (footerEl) {
        const count = data.findings.length;
        const seconds = (data.durationMs / 1000).toFixed(1);
        const parts = [`${count} finding${count === 1 ? '' : 's'}`, `${seconds}s`];
        // A partial report is a success, but say so plainly.
        if (data.incomplete?.length) {
          parts.push(`${data.incomplete.length} check(s) did not complete`);
        }
        footerEl.textContent = parts.join(' · ');
      }

      // Held for the report form, which posts them back to be verified and
      // mailed. Kept in a closure variable rather than a data attribute so
      // nothing has to re-serialise findings through the DOM.
      lastResult = data;

      show(results, true);
    } catch (error) {
      show(status, false);
      if (errorEl) {
        errorEl.textContent =
          error instanceof Error ? error.message : 'The scan could not complete.';
      }
      show(errorEl, true);
    } finally {
      submit.disabled = false;
      submit.textContent = 'Run the Scan';
    }
  });

  reportForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!reportEmail || !reportSubmit || !lastResult) return;

    if (reportStatus) {
      reportStatus.textContent = 'Sending...';
      reportStatus.className = 'mt-4 font-mono text-sm text-paper-mute';
    }
    reportSubmit.disabled = true;

    try {
      const response = await fetch('/api/scan-report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: reportEmail.value,
          result: lastResult,
          // Round-tripped from /api/scan. The server recomputes it over the
          // findings and refuses anything that was edited on the way here.
          signature: (lastResult as { signature?: string }).signature,
        }),
      });

      const data = await response.json();
      if (!response.ok) throw new Error(data.error ?? 'The report could not be sent.');

      /*
       * Only shown on an actual 2xx. The popup this replaces set its success
       * state unconditionally and told people they had subscribed when the
       * request had failed - the single worst thing found in the launch
       * audit, and not a pattern to repeat here.
       */
      if (reportStatus) {
        reportStatus.textContent = 'Sent. Check your inbox.';
        reportStatus.className = 'mt-4 font-mono text-sm text-ink-acid';
      }
      reportForm.reset();
    } catch (error) {
      if (reportStatus) {
        reportStatus.textContent =
          error instanceof Error ? error.message : 'The report could not be sent.';
        reportStatus.className = 'mt-4 font-mono text-sm text-ink-hot';
      }
    } finally {
      reportSubmit.disabled = false;
    }
  });
</script>
