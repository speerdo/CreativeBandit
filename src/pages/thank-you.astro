---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Thank You"
  description="Your message reached Creative Bandit. We reply within one business day with a straight answer on scope, timeline and cost."
>
  <section class="min-h-[70vh] flex items-center justify-center bg-base-200 relative overflow-hidden">
    <!-- Background Elements -->

    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="mb-8 flex justify-center">
        <div class="w-24 h-24 bg-base-100 rounded-full flex items-center justify-center border border-ink-hot/30 shadow-[0_0_30px_rgba(232,69,31,0.2)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-ink-hot" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <h1 class="text-[3.08rem] md:text-[3.83rem] font-bold mb-6 font-heading">Message Received!</h1>
      <p class="text-xl text-paper-mute max-w-2xl mx-auto mb-10">
        Thanks for reaching out to Creative Bandit. We've received your inquiry and will be in touch within <span class="text-white font-semibold">24 hours</span> to schedule your consultation.
      </p>

      <!--
        The primary CTA used to point at /blog, which is three filler posts
        pending deletion. This page is otherwise a dead end, so the wait is
        worth spending on the one thing that produces something useful
        without us: point the scan at a client site and have findings in hand
        before the reply lands.
      -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/scan" class="btn-primary">
          Run a Free Scan While You Wait
        </a>
        <a href="/work" class="btn-secondary">
          See Our Work
        </a>
      </div>

      <p class="mt-12 text-sm text-paper-mute/50">
        While you wait, check your email for a confirmation.
      </p>
    </div>
  </section>
</Layout>
