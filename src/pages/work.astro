    category: 'web',
    categoryName: 'Full-Stack Development / SEO',
    image: '/images/homepowerready_desktop.webp',
    link: 'https://homepowerready.com',
    description: '167 static pages generated from a Neon Postgres catalog of standby generators and battery backup, with sizing and cost calculators shipped as the only JavaScript on the site.',
    client: 'Creative Bandit LLC'
  },
  {
    title: 'eBikeLocal',
    category: 'ai',
    categoryName: 'Directory / AI Data Pipeline',
    image: '/images/ebikelocal_desktop.webp',
    link: 'https://ebikelocal.com',
    description: 'Nationwide e-bike vendor directory fed by a spec-driven pipeline that normalizes dozens of brand-specific APIs and enriches every record through Google Places and Maps.',
    client: 'Creative Bandit LLC'
