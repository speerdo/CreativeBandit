    client: '[TODO: client name]'
  },
  {
    title: '[TODO: Motion Project 3]',
    category: 'motion',
    categoryName: 'Motion Design',
    image: 'https://images.pexels.com/photos/1779489/pexels-photo-1779489.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2',
    link: '#',
    // TODO: replace with real description, before/after, or video/GIF
    description: '[TODO: what the work was and what it did for the client]',
    client: '[TODO: client name]'
