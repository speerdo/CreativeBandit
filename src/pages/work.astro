   *
   * The thumbnail is composed rather than cropped: the card renders images at
   * `h-64 object-cover object-top`, and the Design Bandit lockup is square, so
   * dropped in raw it crops to "SIGN BAND" with the dagger cut off. The webp
   * is that mark centred on a 3:2 ground, built from the master now in
   * assets-src/marks/.
   */
  {
    title: 'Kat Motion Design Projects',
    category: 'design',
    categoryName: 'Motion Design',
    image: '/images/motion-reel-card.webp',
    imageAlt: 'The Design Bandit logo mark',
    link: '/work/motion',
    description: 'Motion design projects from the past.',
    client: 'Various'
  },
  {
    title: '[TODO: Design Project 2]',
    category: 'design',
    categoryName: 'Brand / UI Design',
