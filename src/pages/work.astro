    category: 'ecommerce',
    categoryName: 'E-commerce / SEO',
    image: '/images/recycleoldtech_desktop.webp',
    link: 'https://recycleoldtech.com',
    description: 'Directory of certified US electronics recycling centers, built on Astro and Supabase with an automated SEO pipeline behind an 8.08% affiliate conversion rate.',
    client: 'Creative Bandit LLC'
  },
  {
    title: 'Mounjaro US Website',
    category: 'healthcare',
    categoryName: 'Enterprise Development / Pharma',
    image: '/images/mounjaro_desktop.webp',
    link: 'https://mounjaro.lilly.com',
    description: 'Rebuilt the patient and provider site for Eli Lilly, migrating Nuxt.js to Next.js App Router with a new accessible design system and 90+ Lighthouse scores.',
    client: 'Eli Lilly and Company'
  },
  {
    title: 'EdReports Platform Migration',
