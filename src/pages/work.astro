---

<Layout title="Our Work" description="Production work from Creative Bandit: AI automation, full-stack builds, WordPress, and design and motion, with the measurable result for each.">
  <!-- Hero Section -->
  <section class="section pt-24 relative">
    <div class="container mx-auto">
      <div class="max-w-3xl">
        <p class="label-tech mb-6">Our Portfolio</p>
        <h1 class="mb-6">Real <span class="plate-type">Projects</span>, Real Results</h1>
        <p class="text-xl text-paper-mute mb-8">
          Production applications and design/motion work showcasing AI automation, full-stack development, and measurable business outcomes across healthcare, e-commerce, fintech, and enterprise software.
        </p>
      </div>
    </div>
    
    <div class="absolute top-0 right-0 w-full h-full -z-10">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-ink-hot/10 to-transparent opacity-30"></div>
    </div>
  </section>
  
  <!-- Portfolio Filter and Grid -->
  <section class="pb-24">
    <div class="container mx-auto">
      <!-- Filter Buttons -->
      <div class="flex flex-wrap justify-center mb-12 gap-2">
        {categories.map(category => (
          <button 
            data-filter={category.id} 
            class="chip focus:outline-none filter-btn"
            class:list={[{ 'is-active': category.id === 'all' }]}
          >
            {category.name}
          </button>
        ))}
      </div>
      
      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolio-grid">
        {projects.map(project => (
          <div class="project-item" data-category={project.category}>
            <ProjectCard
              title={project.title}
              category={project.categoryName}
              image={project.image}
              link={project.link}
              description={project.description}
              imageAlt={project.imageAlt}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Case Studies Section -->
  <section class="section bg-base-200">
    <div class="container mx-auto">
      <div class="max-w-3xl mb-16">
        <p class="label-tech mb-4">Featured Projects</p>
        <h2 class="mb-6">Project <span class="plate-type">Highlights</span></h2>
        <p class="text-paper-mute">Detailed look at key projects showcasing AI automation, e-commerce optimization, and healthcare technology solutions.</p>
      </div>
      
      <!-- Featured Case Study -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <img
            src="/images/recycleoldtech_desktop.webp"
            alt="RecycleOldTech.com electronics recycling directory"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </div>

        <div>
          <p class="label-tech mb-4">Featured Project</p>
          <h3 class="text-2xl font-bold mb-3">RecycleOldTech.com</h3>
          <p class="text-paper-mute mb-6">
            Nationwide directory of certified electronics recycling centers across all 50 states. An automated content and SEO pipeline builds and refreshes the location pages, and the monetization sits on top of it: display advertising against the organic traffic plus Amazon Associates placements converting at roughly four times the category average.
          </p>

          <div class="grid grid-cols-2 gap-6 mb-8">
            {featuredStats.map(stat => (
              <div class="border-l-2 border-ink-acid pl-4">
                <p class="text-2xl font-bold">{stat.value}</p>
                <h4 class="text-sm text-paper-mute">{stat.label}</h4>
              </div>
            ))}
          </div>

          <div class="grid grid-cols-2 gap-6 mb-6">
            <div>
              <h4 class="text-sm text-paper-mute mb-1">Type</h4>
              <p>Creative Bandit LLC</p>
            </div>
            <div>
              <h4 class="text-sm text-paper-mute mb-1">Category</h4>
              <p>E-commerce / SEO</p>
            </div>
            <div>
              <h4 class="text-sm text-paper-mute mb-1">Key Result</h4>
              <p>Self-sustaining ad and affiliate revenue</p>
            </div>
            <div>
              <h4 class="text-sm text-paper-mute mb-1">Tech Stack</h4>
              <p>Astro, Supabase, Amazon Associates, Vercel</p>
            </div>
          </div>

          <a href="https://recycleoldtech.com" target="_blank" rel="noopener" class="btn-primary">Visit Site</a>
        </div>
      </div>
      
      <!-- Other Case Studies -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="text-xl font-bold mb-3">DowntownDry AI Verification</h3>
          <p class="text-paper-mute mb-4">Alcohol-free venue directory whose verification pipeline pairs three Google APIs with Gemini, hitting 97% accuracy and cutting manual review time by more than 90%.</p>
          <a href="https://downtowndry.com" target="_blank" rel="noopener" class="text-ink-hot inline-flex items-center font-medium hover:text-ink-acid transition-colors duration-300">
            Visit Site
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 ml-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
        
        <div class="card" id="indiaide">
          <h3 class="text-xl font-bold mb-3">IndiAide RTM System</h3>
          <p class="text-paper-mute mb-4">HIPAA-compliant backend automation for Medicare Remote Therapeutic Monitoring billing. Secure patient data management with automated compliance reporting.</p>
          <span class="text-paper-mute text-sm">Healthcare compliance project (NDA)</span>
        </div>
        
        <div class="card">
          <h3 class="text-xl font-bold mb-3">EdReports Platform</h3>
          <p class="text-paper-mute mb-4">K-12 curriculum review platform migration from Java/Vue to Nuxt.js. 40% faster page loads, 30% developer productivity improvement.</p>
          <a href="https://edreports.org" target="_blank" rel="noopener" class="text-ink-hot inline-flex items-center font-medium hover:text-ink-acid transition-colors duration-300">
            Visit Site
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 ml-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="container mx-auto relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="mb-6">Ready to <span class="plate-type">Start</span> Your Project?</h2>
        <p class="text-paper-mute text-lg mb-8">Tell us what you're working on and we'll figure out the right approach together.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="btn-primary">Contact Us</a>
          <a href="/services" class="btn-secondary">Explore Services</a>
        </div>
      </div>
    </div>
    <div class="absolute top-0 right-0 w-full h-full -z-10">
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
    
    // Initialize - show all projects
    showProjects('all');
    
    // Add click event to filter buttons
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all buttons
        filterBtns.forEach(b => {
          b.classList.remove('is-active');
        });
        
        // Add active class to clicked button
        btn.classList.add('is-active');
        
        // Get filter value
        const filterValue = btn.getAttribute('data-filter');
        showProjects(filterValue);
      });
    });
    
    // Show/hide projects based on filter
    function showProjects(category: string | null) {
      projectItems.forEach(item => {
        const itemCategory = item.getAttribute('data-category');
        
        if (category === 'all' || category === itemCategory) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }
  });
</script>